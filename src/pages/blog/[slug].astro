---
import { render, getCollection } from "astro:content";
import { colorForIndex } from "../../lib/utils";
import Layout from "../../layouts/Layout.astro";
import PatternTitle from "../../components/PatternTitle.astro";
import DitherCanvas from "../../components/DitherCanvas.astro";

export async function getStaticPaths() {
    const notes = (await getCollection("notes")).sort((a, b) => {
        const dateA = a.data.date?.valueOf() ?? 0;
        const dateB = b.data.date?.valueOf() ?? 0;

        return dateB - dateA;
    });

    return notes.map((entry, index) => ({
        params: { slug: entry.id },
        props: {
            entry,
            surfaceColor: colorForIndex(index),
            otherPosts: notes
                .filter((post) => post.id !== entry.id)
                .slice(0, 3),
        },
    }));
}

const { entry, otherPosts, surfaceColor } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const readingMinutes = remarkPluginFrontmatter.readingMinutes;
---

<Layout title={entry.data.title} surfaceColor={surfaceColor}>
    <header>
        <h1 class="title" aria-label={entry.data.title}>
            <PatternTitle title={entry.data.title} idPrefix="article-title" />
        </h1>

        <span>
            <time datetime={entry.data.date.toISOString()} data-relative-date>
                {entry.data.date.toLocaleDateString("en-US", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                })}
            </time>
        </span>
    </header>
    <br />
    <article class="stack">
        <!--
        <div class="prose">
            <p>{entry.data.tagline.toLowerCase()}</p>
        </div>
        -->

        <div class="article-effects">
            <DitherCanvas pixelSize={3} maskSelector="figure" />

            <div class="article-content stack prose-flow">
                <Content />
            </div>
        </div>
    </article>

    {otherPosts.length > 0 && (
        <nav class="more-posts stack" aria-labelledby="more-posts-heading">
            <hr />
            <h2 id="more-posts-heading">Read More</h2>

            <ul class="other-posts">
                {otherPosts.map((post, index) => (
                    <li>
                        <a class="other-post-link" href={`/blog/${post.id}`}>
                            <h3
                                class="other-post-title"
                                aria-label={post.data.title}
                            >
                                <PatternTitle
                                    title={post.data.title}
                                    idPrefix={`other-post-${index}`}
                                    arrow="end"
                                    fill={false}
                                />
                            </h3>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    )}
</Layout>

<script>
    const DAY_IN_MS = 24 * 60 * 60 * 1000;

    function updateRelativeDates() {
        const formatter = new Intl.RelativeTimeFormat("en-US", {
            numeric: "auto",
        });

        document
            .querySelectorAll<HTMLTimeElement>("time[data-relative-date]")
            .forEach((element) => {
                const publishedAt = new Date(element.dateTime);
                const elapsed = Date.now() - publishedAt.getTime();
                const daysAgo = Math.floor(elapsed / DAY_IN_MS);

                if (daysAgo >= 0 && daysAgo < 7) {
                    element.textContent = formatter.format(-daysAgo, "day");
                }
            });
    }

    document.addEventListener("astro:page-load", updateRelativeDates);
</script>

<style>
    h1.title {
        font-size: var(--font-size-title);
        font-weight: 900;
    }
    .article-effects {
        position: relative;
        isolation: isolate;
    }

    .prose,
    .article-content > :global(:not(figure)) {
        margin-inline: auto;
    }

    .article-content > :global(h2) {
        font-size: var(--font-size-xl);
    }

    .article-content > :global(h3) {
        font-size: var(--font-size-lg);
    }

    time {
        text-transform: capitalize;
        color: inherit;
    }

    .article-content > :global(figure) {
        margin: 0;
        overflow: hidden;
        background-color: var(--color-surface-card);
    }

    .article-content :global(figure img) {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: contain;
    }

    article.stack {
        gap: var(--spacing-3xl);
    }

    .article-content > :global(h2:not(:first-child)) {
        margin-block-start: var(--spacing-lg);
    }

    .article-content > :global(h3:not(:first-child)) {
        margin-block-start: var(--spacing-xs);
    }

    .more-posts {
        margin-block-start: var(--spacing-lg);
    }

    .other-posts {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .other-post-link {
        display: block;
        padding-block: var(--spacing-lg);
        color: var(--color-text);
        text-decoration: none;
        transition: color var(--transition-duration-fast)
            var(--transition-timing-standard);
    }

    .other-post-link:is(:hover, :active, :focus-visible) {
        color: var(--color-link);
    }

    .other-post-title {
        margin: 0;
        font-size: var(--font-size-display);
        font-weight: var(--font-weight-normal);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        text-transform: uppercase;
        overflow-wrap: anywhere;
    }

    @media (prefers-reduced-motion: reduce) {
        .other-post-link {
            transition: none;
        }
    }
</style>
