---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const ALL_POSTS = (await getCollection("notes")).sort((a, b) => {
    const dateA = a.data.date?.valueOf() ?? 0;
    const dateB = b.data.date?.valueOf() ?? 0;

    return dateB - dateA;
});

const years = [
    ...new Set(ALL_POSTS.map((post) => post.data.date.getUTCFullYear())),
].sort((a, b) => b - a);

const postGroups = years.map((year) => ({
    year,
    posts: ALL_POSTS.filter((post) => post.data.date.getUTCFullYear() === year),
}));
---

<Layout title="Blog — Lukas Nabholz">
    <section class="stack">
        <p>
            Writings I do from time to time about my projects and sometimes
            other thoughts.
        </p>

        {postGroups.map(({ year, posts }) => (
            <section class="year-group" aria-labelledby={`year-${year}`}>
                <h2 class="year-heading" id={`year-${year}`}>
                    {year}
                </h2>

                <ul class="posts">
                    {posts.map((post, index) => (
                        <li>
                            <a class="post-link" href={`/blog/${post.id}`}>
                                <div class="post-row">
                                    <h2 class="post-title">
                                        {post.data.title}
                                        <span
                                            class="pattern"
                                            aria-hidden="true"
                                        >
                                            <svg
                                                class="pattern-svg"
                                                xmlns="http://www.w3.org/2000/svg"
                                                aria-hidden="true"
                                                focusable="false"
                                                opacity="0.2"
                                            >
                                                <defs>
                                                    <pattern
                                                        id={`post-dots-${index}`}
                                                        width="6"
                                                        height="6"
                                                        patternUnits="userSpaceOnUse"
                                                    >
                                                        <circle
                                                            cx="1.5"
                                                            cy="1.5"
                                                            r="0.8"
                                                            fill="currentColor"
                                                        />
                                                        <circle
                                                            cx="4.5"
                                                            cy="4.5"
                                                            r="0.8"
                                                            fill="currentColor"
                                                        />
                                                    </pattern>
                                                </defs>
                                                <rect
                                                    width="100%"
                                                    height="100%"
                                                    fill={`url(#post-dots-${index})`}
                                                />
                                            </svg>
                                        </span>
                                    </h2>

                                    <span class="arrow" aria-hidden="true">
                                        <svg
                                            viewBox="0 0 48 32"
                                            xmlns="http://www.w3.org/2000/svg"
                                            focusable="false"
                                        >
                                            <path
                                                d="M2 16H44M30 2L44 16L30 30"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="3"
                                                stroke-linecap="square"
                                                stroke-linejoin="miter"
                                            />
                                        </svg>
                                    </span>
                                </div>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        ))}
    </section>
</Layout>

<style>
    .posts {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .post-link {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: var(--spacing-xs);
        padding-block: var(--spacing-lg);
        color: var(--color-text);
        text-decoration: none;
    }

    .post-row {
        position: relative;
        overflow: hidden;
        padding-inline-end: calc(1em + var(--spacing-sm));
        font-size: var(--font-size-display);
        line-height: var(--line-height-tight);
    }

    .post-title {
        margin: 0;
        font-size: inherit;
        font-weight: var(--font-weight-normal);
        line-height: inherit;
        letter-spacing: var(--letter-spacing-tight);
        text-transform: uppercase;
        text-wrap: wrap;
        overflow-wrap: anywhere;
    }

    .pattern {
        display: inline-block;
        position: relative;
        width: 0;
        height: 1cap;
        margin-inline-start: var(--spacing-sm);
        vertical-align: baseline;
    }

    .pattern-svg {
        display: block;
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        width: 100vw;
        max-inline-size: none;
        height: 100%;
    }

    .arrow {
        position: absolute;
        inset-inline-end: 0;
        inset-block-end: 0;
        display: flex;
        align-items: center;
        justify-content: end;
        width: 1em;
        height: 1lh;
        color: inherit;
        background-color: var(--color-background);

        /* Cover the overflowing pattern and leave a gap before the arrow. */
        box-shadow: calc(-1 * var(--spacing-sm)) 0 var(--color-background);
    }

    .arrow svg {
        display: block;
        width: 100%;
        height: 1cap;
        overflow: visible;
    }

    .post-link {
        transition: color var(--transition-duration-fast)
            var(--transition-timing-standard);
    }

    .post-link:is(:hover, :active, :focus-visible) {
        color: var(--color-accent);
    }

    .post-link:focus-visible {
        outline-offset: calc(-1 * var(--outline-width-focus));
    }

    @media (prefers-reduced-motion: reduce) {
        .post-link {
            transition: none;
        }
    }

    .year-group {
        margin-block-start: var(--spacing-xl);
    }

    .year-heading {
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-normal);
        color: var(--color-text-faint);
    }

    .year-group .post-row {
        font-size: clamp(var(--font-size-xl), 3vw, var(--font-size-3xl));
    }
</style>
