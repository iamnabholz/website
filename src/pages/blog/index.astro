---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PatternTitle from "../../components/PatternTitle.astro";

const ALL_POSTS = (await getCollection("notes")).sort((a, b) => {
    const dateA = a.data.date?.valueOf() ?? 0;
    const dateB = b.data.date?.valueOf() ?? 0;

    return dateB - dateA;
});

const FEATURED_POST = ALL_POSTS[0];
---

<Layout title="Blog — Lukas Nabholz">
    <section class="stack">
        <h1 class="title">Blog</h1>

        <p class="prose">
            Writings I do from time to time about my projects and sometimes
            other thoughts.
        </p>

        {FEATURED_POST && (
            <>
                <hr />
                <h2>Featured Post</h2>

                <a
                    class="post-link featured-post"
                    href={`/blog/${FEATURED_POST.id}`}
                >
                    <div class="post-row">
                        <h3
                            class="post-title"
                            aria-label={FEATURED_POST.data.title}
                        >
                            <PatternTitle
                                title={FEATURED_POST.data.title}
                                idPrefix="featured-post-pattern"
                                trailingGap="var(--spacing-sm)"
                            />
                        </h3>

                        <span class="arrow" aria-hidden="true">
                            <svg
                                viewBox="0 0 48 32"
                                xmlns="http://www.w3.org/2000/svg"
                                focusable="false"
                            >
                                <path
                                    d="M2 16H44M30 2L44 16L30 30"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="3"
                                    stroke-linecap="square"
                                    stroke-linejoin="miter"
                                />
                            </svg>
                        </span>
                    </div>

                    <p class="prose featured-tagline">
                        {FEATURED_POST.data.tagline}
                    </p>
                </a>
            </>
        )}

        <hr />
        <h2>All Posts</h2>

        <ul class="posts">
            {ALL_POSTS.map((post, index) => (
                <li>
                    <a class="post-link" href={`/blog/${post.id}`}>
                        <div class="post-row">
                            <h2 class="post-title" aria-label={post.data.title}>
                                <PatternTitle
                                    title={post.data.title}
                                    idPrefix={`post-pattern-${index}`}
                                    trailingGap="var(--spacing-sm)"
                                />
                            </h2>

                            <span class="arrow" aria-hidden="true">
                                <svg
                                    viewBox="0 0 48 32"
                                    xmlns="http://www.w3.org/2000/svg"
                                    focusable="false"
                                >
                                    <path
                                        d="M2 16H44M30 2L44 16L30 30"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="3"
                                        stroke-linecap="square"
                                        stroke-linejoin="miter"
                                    />
                                </svg>
                            </span>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </section>
</Layout>

<style>
    .featured-post .post-row {
        font-size: var(--font-size-title);
        line-height: var(--line-height-none);
    }

    .featured-tagline {
        font-weight: var(--font-weight-normal);
        margin: 0;
    }

    .posts {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .post-link {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: var(--spacing-xs);
        padding-block: var(--spacing-lg);
        color: var(--color-text);
        text-decoration: none;
    }

    .post-row {
        position: relative;
        overflow: hidden;
        padding-inline-end: calc(1em + var(--spacing-sm));
        font-size: var(--font-size-display);
        line-height: var(--line-height-tight);
    }

    .post-title {
        margin: 0;
        font-size: inherit;
        font-weight: var(--font-weight-normal);
        line-height: inherit;
        letter-spacing: var(--letter-spacing-tight);
        text-transform: uppercase;
        text-wrap: wrap;
        overflow-wrap: anywhere;
    }

    .arrow {
        position: absolute;
        inset-inline-end: 0;
        inset-block-end: 0;
        display: flex;
        align-items: center;
        justify-content: end;
        width: 1em;
        height: 1lh;
        color: inherit;
        background-color: var(--color-background);

        /* Cover the overflowing pattern and leave a gap before the arrow. */
        box-shadow: calc(-1 * var(--spacing-sm)) 0 var(--color-background);
    }

    .arrow svg {
        display: block;
        width: 100%;
        height: 1cap;
        overflow: visible;
    }

    .post-link {
        transition: color var(--transition-duration-fast)
            var(--transition-timing-standard);
    }

    .post-link:is(:hover, :active, :focus-visible) {
        color: var(--color-link);
    }

    .post-link:focus-visible {
        outline-offset: calc(-1 * var(--outline-width-focus));
    }

    @media (prefers-reduced-motion: reduce) {
        .post-link {
            transition: none;
        }
    }
</style>
