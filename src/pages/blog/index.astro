---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PatternTitle from "../../components/PatternTitle.astro";

const posts = (await getCollection("notes")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
    title="Blog"
    description="Project notes and occasional writing by product designer and developer Lukas Nabholz."
>
    <section class="stack" aria-labelledby="blog-heading">
        <h1 id="blog-heading" class="visually-hidden">
            Blog
        </h1>

        <p class="prose">Writing I do from time to time.</p>

        <ul class="posts" aria-label="Blog posts">
            {posts.map((post, index) => {
                const isFeatured = index === 0;

                return (
                    <li>
                        <a
                            class:list={[
                                "post-link",
                                { "featured-post": isFeatured },
                            ]}
                            href={`/blog/${post.id}`}
                        >
                            <div class="post-row">
                                <h2
                                    class="post-title"
                                    aria-label={post.data.title}
                                >
                                    <PatternTitle
                                        title={post.data.title}
                                        idPrefix={`post-pattern-${index}`}
                                        arrow={isFeatured ? "flow" : "end"}
                                        fill={isFeatured}
                                    />
                                </h2>
                            </div>

                            {isFeatured && (
                                <p class="prose featured-tagline">
                                    {post.data.tagline}
                                </p>
                            )}
                        </a>
                    </li>
                );
            })}
        </ul>
    </section>
</Layout>

<style>
    section {
        gap: var(--spacing-5xl);
    }
    section > .prose {
        text-indent: var(--text-indent-introduction);
    }

    .posts {
        display: flex;
        flex-direction: column;
        gap: clamp(var(--spacing-2xl), 5vw, var(--spacing-5xl));

        margin: 0;
        padding: 0;
        list-style: none;
    }

    .posts > li {
        min-inline-size: 0;
    }

    .post-link {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);

        min-inline-size: 0;
        inline-size: 100%;

        color: var(--color-text);
        text-decoration: none;

        transition: color var(--transition-duration-fast)
            var(--transition-timing-standard);
    }

    .post-row {
        position: relative;
        overflow: hidden;

        font-size: var(--font-size-display);
        line-height: var(--line-height-none);
    }

    .featured-post .post-row {
        font-size: var(--font-size-title);
    }

    .post-title {
        margin: 0;

        font-size: inherit;
        font-weight: var(--font-weight-normal);
        line-height: inherit;
        letter-spacing: var(--letter-spacing-tight);
        text-transform: uppercase;
        text-wrap: wrap;
        overflow-wrap: anywhere;
    }

    .featured-tagline {
        margin: 0;
        font-weight: var(--font-weight-normal);
    }

    .post-link:is(:hover, :active, :focus-visible) {
        color: var(--color-link);
    }

    .post-link:focus-visible {
        outline-offset: calc(-1 * var(--outline-width-focus));
    }

    @media (prefers-reduced-motion: reduce) {
        .post-link {
            transition: none;
        }
    }
</style>
