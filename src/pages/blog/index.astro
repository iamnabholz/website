---
import Layout from "../../layouts/Layout.astro";
import PatternTitle from "../../components/PatternTitle.astro";
import { getCollection } from "astro:content";

const ALL_POSTS = await getCollection("notes");
const FEATURED_POST = ALL_POSTS[0];
const OTHER_POSTS = ALL_POSTS.slice(1);
---

<Layout title="Blog">
    <Fragment slot="header">
        <h1 class="title" aria-label="Blog">
            <PatternTitle title="Blog" idPrefix="article-title" />
        </h1>

        <p class="prose">
            Writings I do from time to time about my projects and sometimes
            other thoughts.
        </p>
    </Fragment>

    <section class="stack">
        <h2>Latest Note</h2>

        {FEATURED_POST && (
            <a
                class="post-link featured-post"
                href={`/blog/${FEATURED_POST.id}`}
            >
                <div class="post-row">
                    <h3
                        class="post-title"
                        aria-label={FEATURED_POST.data.title}
                    >
                        <PatternTitle
                            title={FEATURED_POST.data.title}
                            idPrefix="featured-post-pattern"
                            trailingGap="var(--spacing-sm)"
                            arrow="flow"
                        />
                    </h3>
                </div>

                <p class="prose featured-tagline">
                    {FEATURED_POST.data.tagline}
                </p>
            </a>
        )}

        <hr />
        <h2>All Notes</h2>

        <ul class="posts">
            {OTHER_POSTS.map((post, index) => (
                <li>
                    <a class="post-link" href={`/blog/${post.id}`}>
                        <div class="post-row">
                            <h2 class="post-title" aria-label={post.data.title}>
                                <PatternTitle
                                    title={post.data.title}
                                    idPrefix={`post-pattern-${index}`}
                                    trailingGap="var(--spacing-sm)"
                                    arrow="end"
                                    fill={false}
                                />
                            </h2>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </section>
</Layout>

<style>
    h1.title {
        font-size: var(--font-size-title);
    }
    .featured-post .post-row {
        font-size: var(--font-size-title);
        line-height: var(--line-height-none);
    }

    .featured-tagline {
        font-weight: var(--font-weight-normal);
        margin: 0;
    }

    .posts {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
    }

    .post-link {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: var(--spacing-xs);
        margin-block: var(--spacing-lg);
        color: var(--color-text);
        text-decoration: none;
    }

    .post-row {
        position: relative;
        overflow: hidden;
        font-size: var(--font-size-display);
        line-height: var(--line-height-none);
    }

    .post-title {
        margin: 0;
        font-size: inherit;
        font-weight: var(--font-weight-normal);
        line-height: inherit;
        letter-spacing: var(--letter-spacing-tight);
        text-transform: uppercase;
        text-wrap: wrap;
        overflow-wrap: anywhere;
    }

    .post-link {
        transition: color var(--transition-duration-fast)
            var(--transition-timing-standard);
    }

    .post-link:is(:hover, :active, :focus-visible) {
        color: var(--color-link);
    }

    .post-link:focus-visible {
        outline-offset: calc(-1 * var(--outline-width-focus));
    }

    @media (prefers-reduced-motion: reduce) {
        .post-link {
            transition: none;
        }
    }
</style>
