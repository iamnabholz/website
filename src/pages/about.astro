---
import Layout from "../layouts/Layout.astro";
import Sticker from "../components/Sticker.astro";
import CurrentTime from "../components/CurrentTime.astro";
---

<Layout title="About — Lukas Nabholz" header="— From Santa Cruz, Bolivia.">
    <section class="content stack">
        <p>
            Passionate about design, software, music, and games. Start messy and
            narrow it down until it feels obvious.
        </p>
        <p>
            I spend my days designing experiences people actually enjoy using,
            and my nights building tools and apps that other developers and
            designers use.
        </p>
        <p>
            You can find me posting more about me and what I do on{" "}
            <a href="https://www.threads.com/@nabholzwork" rel="me">
                Threads
            </a>
            or{" "}
            <a href="https://www.bluesky.com/@nabholz.work" rel="me">
                Bluesky
            </a>
            .
        </p>
    </section>
    <section class="content">
        <h2>Skills</h2>
        <ul>
            <li>Product Design</li>
            <li>Front-end Dev</li>
            <li>UI/UX Design</li>
            <li>Web Design</li>
        </ul>
    </section>

    <section class="content">
        <h2>Experience</h2>

        <dl class="list">
            <div>
                <dt>
                    Ongoing— <br /> 2018
                </dt>
                <dd>Freelance Work</dd>
            </div>

            <div>
                <dt>
                    2018— <br /> 2015
                </dt>
                <dd>UX Designer at Monotone Works</dd>
            </div>
        </dl>
    </section>

    <section class="content">
        <h2>Languages</h2>

        <dl class="list">
            <div>
                <dt>English</dt>
                <dd>Proficient</dd>
            </div>

            <div>
                <dt>Spanish</dt>
                <dd>Native</dd>
            </div>
        </dl>
    </section>

    <address class="content contact">
        <h2>Contact</h2>

        <dl class="list">
            <div>
                <dt>Location</dt>
                <dd>Santa Cruz, Bolivia</dd>
                <dd>
                    <CurrentTime />
                </dd>
            </div>

            <div>
                <dt>Email</dt>
                <dd>
                    <a href="mailto:hi@nabholz.work">hi@nabholz.work</a>
                </dd>
            </div>

            <div>
                <dt>Threads</dt>
                <dd>
                    <a href="https://threads.com/@nabholzwork">@nabholzwork</a>
                </dd>
            </div>

            <div>
                <dt>Bluesky</dt>
                <dd>
                    <a href="https://bsky.app/profile/nabholz.work">
                        @nabholz.work
                    </a>
                </dd>
            </div>
        </dl>
    </address>

    <div class="content stickers-space">
        <Sticker sticker="cursor" size="4rem" visualScale={1.4} />
        <Sticker size="4rem" visualScale={1.4} />
        <Sticker size="4rem" visualScale={1.4} />
    </div>
</Layout>

<style>
    .stickers-space {
        padding-block: var(--spacing-4xl);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        color: black;
    }

    ul {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--spacing-2xs);
        list-style: none;
    }

    ul li {
        border: 1px solid lightgray;
        padding: var(--spacing-2xs) var(--spacing-md);
        border-radius: 999px;
        display: inline-block;
        width: fit-content;
    }
</style>
