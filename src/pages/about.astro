---
import Layout from "../layouts/Layout.astro";
import Sticker from "../components/Sticker.astro";
import CurrentTime from "../components/CurrentTime.astro";
---

<Layout title="About — Lukas Nabholz">
    <Fragment slot="header">
        <h1 class="title">About</h1>
    </Fragment>

    <section class="stack prose">
        <p>
            Passionate about design, software, music, and games. Start messy and
            narrow it down until it feels obvious.
        </p>
        <p>
            I spend my days designing experiences people actually enjoy using,
            and my nights building tools and apps that other developers and
            designers use.
        </p>
        <p>
            You can find me posting more about me and what I do on{" "}
            <a href="https://www.threads.com/@nabholzwork" rel="me">
                Threads
            </a>
            or{" "}
            <a href="https://www.bluesky.com/@nabholz.work" rel="me">
                Bluesky
            </a>
            .
        </p>
    </section>

    <section>
        <h2 class="section-heading">Languages</h2>

        <dl class="list">
            <div>
                <dt>English</dt>
                <dd>Proficient</dd>
            </div>

            <div>
                <dt>Spanish</dt>
                <dd>Native</dd>
            </div>
        </dl>
    </section>

    <section>
        <h2 class="section-heading">Skills</h2>
        <ul>
            <li>Product Design</li>
            <li>Front-end Dev</li>
            <li>UI/UX Design</li>
            <li>Web Design</li>
        </ul>
    </section>

    <section class="contact">
        <h2 class="section-heading">Contact</h2>

        <address>
            <dl class="list">
                <div>
                    <dt>Location</dt>
                    <dd>Santa Cruz, Bolivia</dd>
                    <dd>
                        <CurrentTime />
                    </dd>
                </div>

                <div>
                    <dt>Email</dt>
                    <dd>
                        <a href="mailto:hi@nabholz.work">hi@nabholz.work</a>
                    </dd>
                </div>

                <div>
                    <dt>Threads</dt>
                    <dd>
                        <a href="https://threads.com/@nabholzwork">
                            @nabholzwork
                        </a>
                    </dd>
                </div>

                <div>
                    <dt>Bluesky</dt>
                    <dd>
                        <a href="https://bsky.app/profile/nabholz.work">
                            @nabholz.work
                        </a>
                    </dd>
                </div>
            </dl>
        </address>
    </section>

    <div class="stickers-space">
        <Sticker sticker="cursor" size="4rem" visualScale={1.4} />
        <Sticker size="4rem" visualScale={1.4} />
        <Sticker size="4rem" visualScale={1.4} />
    </div>
</Layout>

<style>
    .stickers-space {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        padding-block: var(--spacing-xl);
    }

    .stickers-space > :global(.sticker-space) {
        flex: none;
        width: var(--sticker-size);
        height: var(--sticker-size);
    }

    .stickers-space :global(.sticker-wrapper) {
        top: 50%;
    }

    ul {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--spacing-2xs);
        list-style: none;
    }

    ul li {
        border: var(--border-width-thin) solid var(--color-border);
        padding: var(--spacing-2xs) var(--spacing-md);
        border-radius: var(--border-radius-full);
        display: inline-block;
        width: fit-content;
    }
</style>
