---
import CurrentTime from "../components/CurrentTime.astro";
import Sticker from "../components/Sticker.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
    <div class="introduction">
        <p class="introduction__statement">
            Product designer and developer building digital experiences that
            people actually enjoy using.
        </p>

        <p class="introduction__statement">
            Tinkering until it feels right, I have 8+ years of experience
            working as a freelancer. I’m currently open to work and
            collaborations—or just a chat.
        </p>

        <address class="introduction__statement introduction__contact">
            Reach me by email at{" "}
            <a href="mailto:hi@nabholz.work">hi@nabholz.work</a>
            {" or find me as "}
            <a href="https://www.threads.com/@nabholzwork" rel="me">
                @nabholzwork
            </a>
            on Threads.
        </address>
    </div>

    <section class="contact">
        <h2 class="section-heading">Contact</h2>

        <address>
            <dl class="list">
                <div>
                    <dt>Location</dt>
                    <dd>Santa Cruz, Bolivia</dd>
                    <dd>
                        <CurrentTime />
                    </dd>
                </div>

                <div>
                    <dt>Email</dt>
                    <dd>
                        <a href="mailto:hi@nabholz.work">hi@nabholz.work</a>
                    </dd>
                </div>

                <div>
                    <dt>Threads</dt>
                    <dd>
                        <a href="https://threads.com/@nabholzwork">
                            @nabholzwork
                        </a>
                    </dd>
                </div>

                <div>
                    <dt>Bluesky</dt>
                    <dd>
                        <a href="https://bsky.app/profile/nabholz.work">
                            @nabholz.work
                        </a>
                    </dd>
                </div>
            </dl>
        </address>
    </section>

    <div class="stickers-space">
        <Sticker sticker="cursor" size="4rem" visualScale={1.4} />
        <Sticker size="4rem" visualScale={1.4} />
        <Sticker size="4rem" visualScale={1.4} />
    </div>
</Layout>

<style>
    h1.title {
        font-size: var(--font-size-title);
    }

    .introduction {
        display: flex;
        flex-direction: column;
        gap: clamp(2.5rem, 6vw, 7rem);
        inline-size: 100%;
    }

    .introduction__statement {
        max-inline-size: min(100%, 24ch);
        margin: 0;

        font-size: var(--font-size-introduction);
        font-weight: var(--font-weight-normal);
        line-height: 1.02;
        letter-spacing: -0.04em;

        text-wrap: pretty;
    }

    p.introduction__statement:first-of-type {
        text-indent: var(--text-indent-introduction);
    }

    .introduction__contact {
        font-style: normal;
    }

    .introduction__contact a {
        overflow-wrap: anywhere;
        text-decoration-thickness: 0.06em;
        text-underline-offset: 0.12em;
    }

    .stickers-space {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        padding-block-start: var(--spacing-4xl);
    }

    @media (max-width: 720px) {
        .introduction {
            gap: clamp(2.5rem, 12vw, 4rem);
        }

        .introduction__statement {
            max-inline-size: none;
            line-height: 1.05;
            letter-spacing: -0.035em;
        }
    }

    @media (max-width: 380px) {
        .introduction__statement {
            font-size: clamp(1.75rem, 9vw, 2rem);
            line-height: 1.08;
            letter-spacing: -0.03em;
        }
    }
</style>
