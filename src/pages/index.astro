---
import Layout from "../layouts/Layout.astro";
import SelectedWorks from "../components/SelectedWorks.astro";
import CurrentTime from "../components/CurrentTime.astro";

const projectGroups = [
    {
        label: "Ongoing",
        projects: [
            {
                title: "Panorama Tab",
                description: "New tab browser extension",
                href: "/panorama",
            },
            {
                title: "other projects",
                description: "",
                href: null,
            },
        ],
    },
    {
        label: "2026",
        projects: [
            {
                title: "GoodBadPassword",
                description: "",
                href: null,
            },
            {
                title: "Panorama Tab",
                description: "New tab browser extension",
                href: "/panorama",
            },
        ],
    },
    {
        label: "2025",
        projects: [
            {
                title: "Timesets",
                description: "Build your own pomodoro-like timers.",
                href: "/blog/timesets",
            },
        ],
    },
];
---

<Layout title="Home — Lukas Nabholz">
    <SelectedWorks />

    <section class="content">
        <h2>Side Projects</h2>

        <dl class="projects">
            {projectGroups.map((group) => (
                <div>
                    <dt>{group.label}</dt>

                    {group.projects.map((project) => {
                        const Tag = project.href ? "a" : "div";

                        return (
                            <dd>
                                <Tag
                                    class="project-card"
                                    href={project.href ?? undefined}
                                >
                                    <span
                                        class="project-icon"
                                        aria-hidden="true"
                                    >
                                        {/* Add a decorative image or SVG here. */}
                                    </span>

                                    <div class="project-copy">
                                        <span class="project-title">
                                            {project.title}
                                        </span>

                                        {project.description && (
                                            <p>{project.description}</p>
                                        )}
                                    </div>
                                </Tag>
                            </dd>
                        );
                    })}
                </div>
            ))}
        </dl>
    </section>

    <address class="content contact">
        <h2>Contact</h2>

        <dl class="list">
            <div>
                <dt>Location</dt>
                <dd>Santa Cruz, Bolivia</dd>
                <dd>
                    <CurrentTime />
                </dd>
            </div>

            <div>
                <dt>Email</dt>
                <dd>
                    <a href="mailto:hi@nabholz.work">hi@nabholz.work</a>
                </dd>
            </div>

            <div>
                <dt>Threads</dt>
                <dd>
                    <a href="https://threads.com/@nabholzwork">@nabholzwork</a>
                </dd>
            </div>

            <div>
                <dt>Bluesky</dt>
                <dd>
                    <a href="https://bsky.app/profile/nabholz.work">
                        @nabholz.work
                    </a>
                </dd>
            </div>
        </dl>
    </address>
</Layout>

<style>
    .projects {
        row-gap: var(--spacing-lg);
    }

    .projects > div {
        align-items: start;
        row-gap: var(--spacing-xs);
    }

    .projects > div > dt {
        padding-top: var(--spacing-md);
    }

    .project-card {
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr);
        align-items: start;
        gap: var(--spacing-md);
        width: 100%;
        padding: var(--spacing-md);

        border: var(--border-width-thin) solid var(--color-border);
        border-radius: var(--border-radius-lg);

        color: var(--color-text);
        font-weight: var(--font-weight-normal);
        text-decoration: none;
    }

    a.project-card:is(:hover, :active, :focus-visible) {
        color: var(--color-text);
    }

    /* Prevent external-link arrows becoming an extra grid item. */
    a.project-card[href^="http"]::after {
        content: none;
    }

    .project-icon {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
    }

    .project-icon > :global(img),
    .project-icon > :global(svg) {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .project-copy {
        min-width: 0;
    }

    .project-title {
        font-weight: var(--font-weight-semibold);
    }

    a.project-card .project-title {
        text-decoration-line: underline;
        text-decoration-thickness: var(--text-decoration-thickness-link);
        text-underline-offset: var(--text-underline-offset-link);
        text-decoration-color: color-mix(
            in srgb,
            currentColor 40%,
            transparent
        );
    }

    a.project-card:is(:hover, :active, :focus-visible) .project-title {
        color: var(--color-accent);
        text-decoration-color: var(--color-accent);
    }

    .project-copy p {
        margin: var(--spacing-2xs) 0 0;
        color: var(--color-text-faint);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-normal);
        line-height: var(--line-height-snug);
    }

    @media (max-width: 600px) {
        .projects {
            grid-template-columns: minmax(0, 1fr);
        }

        .projects > div > dt,
        .projects > div > dd {
            grid-column: 1;
        }

        .projects > div > dt {
            padding-top: 0;
        }
    }
</style>
