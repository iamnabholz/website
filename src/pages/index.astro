---
import Layout from "../layouts/Layout.astro";
import WorksFeed from "../components/WorksFeed.astro";
import Sticker from "../components/Sticker.astro";
---

<Layout title="Home">
    <Fragment slot="header">
        <div class="introduction">
            <h1 class="introduction__statement">
                <strong class="introduction__name">
                    Lukas Nabholz{"    "}
                </strong>
                <span aria-hidden="true">
                    <Sticker visualScale={1.6} sticker="keycap" />
                </span>
            </h1>

            <p class="introduction__statement">
                Product designer and developer building digital experiences that
                people actually enjoy using.
            </p>

            <p class="introduction__statement">
                Currently solving complex problems and helping new ideas achieve
                their goals by crafting intuitive, easy-to-use interfaces that
                are beautiful.
            </p>

            <address class="introduction__statement introduction__contact">
                Reach me by email at{" "}
                <a href="mailto:hi@nabholz.work">hi@nabholz.work</a>
                {" or find me as "}
                <a
                    href="https://threads.com/nabholzwork"
                    target="_blank"
                    rel="noreferrer"
                >
                    @nabholzwork
                </a>
                on Threads.
            </address>
        </div>
    </Fragment>

    <section class="works" aria-labelledby="works-heading">
        <h2 class="section-heading" id="works-heading">
            Selected work
        </h2>
        <WorksFeed />
    </section>
</Layout>

<style>
    .introduction {
        display: flex;
        flex-direction: column;
        gap: clamp(2.5rem, 6vw, 7rem);
        inline-size: 100%;
    }

    .introduction__statement {
        font-size: clamp(2rem, 1.2rem + 3.4vw, 5.75rem);
        font-weight: var(--font-weight-normal);
        line-height: 1.02;
        letter-spacing: -0.04em;
        margin: 0;

        text-indent: 0;
        text-wrap: pretty;
    }

    /* Opening statement */
    p.introduction__statement:first-of-type,
    h1.introduction__statement {
        max-inline-size: min(100%, 24ch);
        text-indent: clamp(1rem, 4vw, 4rem);
    }

    /* Longer supporting paragraph */
    p.introduction__statement {
        max-inline-size: min(100%, 30ch);
    }

    /* Contact block */
    address.introduction__statement {
        max-inline-size: min(100%, 26ch);
    }

    .introduction__name {
        font-weight: var(--font-weight-semibold);
        letter-spacing: -0.045em;
        white-space: nowrap;
    }

    .introduction__contact {
        font-style: normal;
    }

    .introduction__contact a {
        font-weight: var(--font-weight-semibold);
        overflow-wrap: anywhere;
        text-decoration-thickness: 0.06em;
        text-underline-offset: 0.12em;
    }

    .works {
        inline-size: 100%;
    }

    .works .section-heading {
        margin-block-end: clamp(var(--spacing-md), 2vw, var(--spacing-xl));
    }

    @media (max-width: 720px) {
        .introduction {
            gap: clamp(2.5rem, 12vw, 4rem);
        }

        .introduction__statement {
            max-inline-size: none;
            line-height: 1.05;
            letter-spacing: -0.035em;
        }

        .introduction__name {
            letter-spacing: -0.04em;
        }
    }

    @media (max-width: 380px) {
        .introduction__statement {
            font-size: clamp(1.75rem, 9vw, 2rem);
            line-height: 1.08;
            letter-spacing: -0.03em;
        }

        .introduction__name {
            letter-spacing: -0.035em;
        }
    }
</style>
