---
import Layout from "../layouts/Layout.astro";
import ImageShowcase from "../components/ImageShowcase.astro";
import Sticker from "../components/Sticker.astro";
import Work from "../components/Work.astro";

import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
    // only get posts marked as selected
    .filter((post) => post.data.selected === true)
    .sort((a, b) => {
        const dateA = a.data.date?.valueOf() ?? 0;
        const dateB = b.data.date?.valueOf() ?? 0;

        // newest first
        return dateB - dateA;
    });
---

<Layout title="Lukas Nabholz">
    <section class="content stack">
        <h1 class="hero-text prose">
            <b>Lukas Nabholz</b>.{" "}
            <Sticker sticker="mac" visualScale={1.6} size="0.8em" />
            Designer and coder who turns rough ideas into things people actually
            enjoy using.
        </h1>
        <p class="hero-text prose">
            I build tools, websites, apps, games, and anything that sounds fun.{" "}
            <Sticker sticker="cursor" visualScale={2} size="0.8em" />
        </p>
        <p class="links stack">
            <a href="/about">
                more about me
                <span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1.2em"
                        height="1.2em"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M12 5l0 14" />
                        <path d="M5 12l14 0" />
                    </svg>
                </span>
            </a>
            <a href="/blog">
                see my work
                <span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="1.2em"
                        height="1.2em"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M6 17.6l-2 -1.1v-2.5" />
                        <path d="M4 10v-2.5l2 -1.1" />
                        <path d="M10 4.1l2 -1.1l2 1.1" />
                        <path d="M18 6.4l2 1.1v2.5" />
                        <path d="M20 14v2.5l-2 1.12" />
                        <path d="M14 19.9l-2 1.1l-2 -1.1" />
                        <path d="M12 12l2 -1.1" />
                        <path d="M18 8.6l2 -1.1" />
                        <path d="M12 12l0 2.5" />
                        <path d="M12 18.5l0 2.5" />
                        <path d="M12 12l-2 -1.12" />
                        <path d="M6 8.6l-2 -1.1" />
                    </svg>
                </span>
            </a>
        </p>
        <p>
            <a href="mailto:lukas@nabholz.work">lukas@nabholz.work</a>
            <br />
            <a href="https://www.threads.com/@nabholzwork">@nabholzwork</a>
        </p>
    </section>

    <section class="works">
        {posts.map((post) => (
            <Work
                title={post.data.title}
                tagline={post.data.tagline}
                href={`/blog/${post.id}`}
            >
                <ImageShowcase
                    images={post.data.images ?? []}
                    background={post.data.background}
                />
            </Work>
        ))}
    </section>
</Layout>

<style>
    .hero-text {
        font-family: var(--font-sans);
        font-size: var(--fs-2xl);
        line-height: var(--lh-tight);
        font-weight: var(--fw-normal);
    }

    .works {
        display: flex;
        flex-direction: column;
        gap: var(--space-24);
        padding-top: var(--space-24);
    }

    .links {
        gap: var(--space-4);
    }

    .links a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        font-size: var(--fs-base);
        text-decoration: none;
        text-transform: lowercase;
        padding-block: var(--space-4);
        border-bottom: 1px solid var(--color-border);
    }
</style>
