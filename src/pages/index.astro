---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import SelectedProjects from "../components/SelectedProjects.astro";
import CurrentTime from "../components/CurrentTime.astro";

import PROJECTS from "../content/projects.json";

const icons = import.meta.glob<{ default: ImageMetadata }>(
    "/src/content/media/icons/*",
    { eager: true },
);

function resolveIcon(path: string): ImageMetadata {
    const icon = icons[path];

    if (!icon) {
        throw new Error(`Project icon not found: ${path}`);
    }

    return icon.default;
}
---

<Layout
    title="Home — Lukas Nabholz"
    header="— Product designer and developer building digital experiences that people actually enjoy using."
>
    <SelectedProjects />

    <section class="content">
        <h2>More Projects</h2>

        <dl class="projects">
            {PROJECTS.map((group) => (
                <div>
                    <dt>{group.label}</dt>

                    {group.projects.map((project) => {
                        const Tag = project.href ? "a" : "div";

                        return (
                            <dd>
                                <Tag
                                    class="project-card"
                                    href={project.href ?? undefined}
                                >
                                    <span
                                        class="project-icon"
                                        aria-hidden="true"
                                    >
                                        <Image
                                            src={resolveIcon(project.icon)}
                                            alt=""
                                            width={80}
                                            height={80}
                                            loading="lazy"
                                        />
                                    </span>

                                    <div class="project-copy">
                                        <span class="project-title">
                                            {project.title}
                                        </span>

                                        {project.description && (
                                            <p>{project.description}</p>
                                        )}
                                    </div>
                                </Tag>
                            </dd>
                        );
                    })}
                </div>
            ))}
        </dl>
    </section>

    <address class="content contact">
        <h2>Contact</h2>

        <dl class="list">
            <div>
                <dt>Location</dt>
                <dd>Santa Cruz, Bolivia</dd>
                <dd>
                    <CurrentTime />
                </dd>
            </div>

            <div>
                <dt>Email</dt>
                <dd>
                    <a href="mailto:hi@nabholz.work">hi@nabholz.work</a>
                </dd>
            </div>

            <div>
                <dt>Threads</dt>
                <dd>
                    <a href="https://threads.com/@nabholzwork">@nabholzwork</a>
                </dd>
            </div>

            <div>
                <dt>Bluesky</dt>
                <dd>
                    <a href="https://bsky.app/profile/nabholz.work">
                        @nabholz.work
                    </a>
                </dd>
            </div>
        </dl>
    </address>
</Layout>

<style>
    .projects {
        row-gap: var(--spacing-2xl);
    }

    .projects > div {
        align-items: start;
        row-gap: var(--spacing-md);
    }

    .project-card {
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr);
        align-items: start;
        gap: var(--spacing-md);
        width: 100%;

        color: var(--color-text);
        font-weight: var(--font-weight-normal);
        text-decoration: none;
    }

    a.project-card:is(:hover, :active, :focus-visible) {
        color: var(--color-text);
    }

    /* Prevent external-link arrows becoming an extra grid item. */
    a.project-card[href^="http"]::after {
        content: none;
    }

    .project-icon {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: var(--border-radius-md);
        overflow: hidden;
    }

    .project-icon > :global(img),
    .project-icon > :global(svg) {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .project-copy {
        min-width: 0;
    }

    .project-title {
        font-weight: var(--font-weight-semibold);
        transition: all 150ms linear;
    }

    a.project-card .project-title {
        text-decoration-line: underline;
        text-decoration-thickness: var(--text-decoration-thickness-link);
        text-underline-offset: var(--text-underline-offset-link);
        text-decoration-color: color-mix(
            in srgb,
            currentColor 40%,
            transparent
        );
    }

    a.project-card:is(:hover, :active, :focus-visible) .project-title {
        color: var(--color-accent);
        text-decoration-color: var(--color-accent);
    }

    .project-copy p {
        margin: var(--spacing-2xs) 0 0;
        color: var(--color-text-faint);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-normal);
        line-height: var(--line-height-snug);
    }

    @media (max-width: 600px) {
        .projects {
            grid-template-columns: minmax(0, 1fr);
        }

        .projects > div > dt,
        .projects > div > dd {
            grid-column: 1;
        }

        .projects > div > dt {
            padding-top: 0;
        }
    }
</style>
