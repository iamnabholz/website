---
import CurrentTime from "../components/CurrentTime.astro";
import Selected from "../components/SelectedWork.astro";
import Sticker from "../components/Sticker.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Home"
    description="Portfolio of Lukas Nabholz, a product designer and developer building digital experiences people enjoy using."
>
    <div class="introduction">
        <h1 class="introduction__statement introduction__headline">
            Product designer and developer turning ideas into thoughtful digital
            experiences.
        </h1>

        <p class="introduction__statement">
            With 8+ years of freelance experience, I work across design and code
            to bring ideas to life, from the first sketch to the final
            interaction.
        </p>

        <address class="introduction__statement introduction__contact">
            Reach me at{" "}
            <a target="_blank" href="mailto:hi@nabholz.work">
                hi@nabholz.work
            </a>
            {" or find me as "}
            <a
                target="_blank"
                href="https://www.threads.com/@nabholzwork"
                rel="me"
                style="text-wrap: nowrap;"
            >
                @nabholzwork
            </a>
            on Threads.
        </address>
    </div>

    <section class="home-section">
        <h2 class="section-heading">Selected Projects</h2>

        <Selected />
    </section>

    <section class="home-section">
        <h2 class="section-heading">Game Development</h2>

        <p class="prose">
            I also make games under the name Fabric Visions, often for short
            game jams to create small, mostly pixel-art projects. Check out my
            latest game,{" "}
            <a
                target="_blank"
                rel="noreferrer"
                href="https://fabricvisions.itch.io/crownfall"
            >
                CROWNFALL
            </a>
            . And play all my other games on{" "}
            <a
                target="_blank"
                rel="noreferrer"
                href="https://fabricvisions.itch.io"
            >
                itch.io
            </a>
            .
        </p>
    </section>

    <section class="home-section">
        <h2 class="section-heading">Contact</h2>

        <address>
            <dl class="list">
                <div>
                    <dt>Location</dt>
                    <dd>Santa Cruz, Bolivia</dd>
                </div>

                <div>
                    <dt>Local Time</dt>
                    <dd>
                        <CurrentTime />
                    </dd>
                </div>

                <div>
                    <dt>Email</dt>
                    <dd>
                        <a href="mailto:hi@nabholz.work">hi@nabholz.work</a>
                    </dd>
                </div>
            </dl>
        </address>
    </section>

    <section class="home-section">
        <h2 class="section-heading">Links</h2>

        <address>
            <dl class="list">
                <div>
                    <dt>Threads</dt>
                    <dd>
                        <a href="https://www.threads.com/@nabholzwork" rel="me">
                            @nabholzwork
                        </a>
                    </dd>
                </div>

                <div>
                    <dt>Bluesky</dt>
                    <dd>
                        <a
                            href="https://bsky.app/profile/nabholz.work"
                            rel="me"
                        >
                            @nabholz.work
                        </a>
                    </dd>
                </div>

                <div>
                    <dt>GitHub</dt>
                    <dd>
                        <a href="https://github.com/iamnabholz" rel="me">
                            @iamnabholz
                        </a>
                    </dd>
                </div>

                <div>
                    <dt>Buy Me A Coffee</dt>
                    <dd>
                        <a href="https://buymeacoffee.com/nabholz" rel="me">
                            @nabholz
                        </a>
                    </dd>
                </div>
            </dl>
        </address>
    </section>

    <div class="stickers-space">
        <Sticker sticker="cursor" size="4rem" visualScale={1.4} />
        <Sticker size="4rem" visualScale={1.4} />
        <Sticker size="4rem" visualScale={1.4} />
    </div>
</Layout>

<style>
    .introduction {
        display: flex;
        flex-direction: column;
        gap: clamp(var(--spacing-2xl), 6vw, var(--spacing-5xl));

        inline-size: 100%;
    }

    .introduction__statement {
        max-inline-size: min(100%, 24ch);
        margin: 0;

        font-size: var(--font-size-introduction);
        font-weight: var(--font-weight-normal);
        line-height: var(--line-height-display);
        letter-spacing: var(--letter-spacing-display);

        text-wrap: pretty;
    }

    .introduction__headline {
        text-indent: var(--text-indent-introduction);
    }

    .introduction__contact {
        font-style: normal;
    }

    .introduction__contact a {
        overflow-wrap: anywhere;
        text-decoration-thickness: 0.06em;
        text-underline-offset: 0.12em;
    }

    .home-section {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
    }

    .home-section .section-heading {
        margin: 0;
    }

    .stickers-space {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--spacing-sm);

        height: 2em;
    }

    @media (max-width: 720px) {
        .introduction__statement {
            max-inline-size: none;
        }
    }
</style>
