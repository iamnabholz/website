---
import "../styles/styles.css";
import SiteNav from "../components/SiteNav.astro";
import { ClientRouter } from "astro:transitions";
import DitherCanvas from "../components/DitherCanvas.astro";

const { title, hideFooter = false } = Astro.props;

const hasHeader = Astro.slots.has("header");
const isHome = Astro.url.pathname === "/";
const isBlog = Astro.url.pathname.startsWith("/blog/");

const DESCRIPTION = "Find the works and projects of Lukas Nabholz.";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{title}</title>

        <meta name="author" content="Lukas Nabholz" />
        <meta name="description" content={DESCRIPTION} />
        <!-- other meta tags -->
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />
        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />

        <!-- Open Graph / Social meta tags -->
        <meta property="og:title" content={title} />
        <!-- other social meta tags -->
        <meta property="og:description" content={DESCRIPTION} />
        <meta
            property="og:image"
            content="https://nabholz.work/website_cover.png"
        />
        <meta
            property="og:image:alt"
            content="A sticker designed by Lukas Nabholz or a solid colored background."
        />

        <meta property="og:url" content="https://nabholz.work/" />
        <meta property="og:type" content="website" />

        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <!-- other link tags (excluding stylesheets and resource hints) -->
        <!-- Icons -->
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preconnect" href="https://nabholz.work/" />
        <link rel="dns-prefetch" href="https://nabholz.work/" />

        <ClientRouter />
    </head>
    <body id="top">
        <header
            class:list={["site-header", { "site-header-with-hero": hasHeader }]}
        >
            {hasHeader && (
                <>
                    <div class="header-dither-mask" data-dither-mask></div>
                    <DitherCanvas pixelSize={4} />
                </>
            )}

            <div class="header-content">
                <div class="row">
                    <b>LUKAS NABHOLZ</b>

                    {isHome ? (
                        <a class="back-link" href="/about">
                            about
                        </a>
                    ) : (
                        <a class="back-link" href="/">
                            works
                        </a>
                    )}
                </div>
                <!--
                <SiteNav variant="header" label="Primary navigation" />


                {isBlog && (
                    <a class="back-link" href="/">
                        Back home
                    </a>
                )}
                -->

                {hasHeader && (
                    <div class="header-intro">
                        <slot name="header" />
                    </div>
                )}
            </div>
        </header>

        <div id="animation-wrapper">
            <div class="page-content">
                <main class="stack">
                    <slot />
                </main>

                {hideFooter ? (
                    ""
                ) : (
                    <footer class="stack">
                        <a class="back-link" href="#top">
                            Scroll up
                        </a>
                        <SiteNav variant="footer" label="Footer navigation" />
                        <p>Designed and developed by Lukas Nabholz</p>
                    </footer>
                )}
            </div>
        </div>
    </body>
</html>

<style>
    .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    body {
        min-height: 100dvh;
        margin: 0;
        padding: 0;
        isolation: isolate;
    }

    /* Background layers span the viewport. */
    .site-header {
        position: relative;
        isolation: isolate;
        color: var(--color-text-black);
        background-color: var(--color-surface-card);
    }

    .site-header-with-hero {
        position: sticky;
        inset-block-start: 0;
        z-index: 0;
    }

    .header-dither-mask {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    /* Both layers use exactly the same content boundary and padding. */
    .header-content,
    .page-content {
        box-sizing: border-box;
        inline-size: 100%;
        max-inline-size: 1920px;
        margin-inline: auto;
        padding: var(--spacing-lg) var(--padding-inline-page);
    }

    .header-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 24rem;
        gap: var(--spacing-xl);
    }

    .header-intro {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .header-intro :global(.title) {
        margin: 0;
    }

    /* Opaque and above the header, including outside the content boundary. */
    #animation-wrapper {
        position: relative;
        z-index: 1;
        background-color: var(--color-background);
        animation: slide-up var(--transition-duration-slow)
            var(--transition-timing-out) var(--animation-delay-short) both;
    }

    main {
        gap: var(--spacing-4xl);
        padding-block: var(--spacing-lg);
    }

    footer {
        gap: var(--spacing-xs);
        color: var(--color-text-faint);
        font-size: var(--font-size-sm);
    }

    .back-link {
        text-transform: uppercase;
        font-size: var(--font-size-sm);
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(var(--spacing-4xl));
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #animation-wrapper {
            animation: none;
        }
    }
</style>
