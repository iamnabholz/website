---
import "../styles/styles.css";
import SiteNav from "../components/SiteNav.astro";
import { ClientRouter } from "astro:transitions";

const { title, hideFooter = false } = Astro.props;

const hasHeader = Astro.slots.has("header");
const finalTitle = `${title} — Lukas Nabholz`;

const DESCRIPTION = "Find the works and projects of Lukas Nabholz.";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{finalTitle}</title>

        <meta name="author" content="Lukas Nabholz" />
        <meta name="description" content={DESCRIPTION} />
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />

        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={DESCRIPTION} />
        <meta
            property="og:image"
            content="https://nabholz.work/website_cover.png"
        />
        <meta
            property="og:image:alt"
            content="A sticker designed by Lukas Nabholz or a solid colored background."
        />
        <meta property="og:url" content="https://nabholz.work/" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preconnect" href="https://nabholz.work/" />
        <link rel="dns-prefetch" href="https://nabholz.work/" />

        <ClientRouter />
    </head>

    <body id="top">
        <div id="animation-wrapper">
            <div class="page-content content-boundary">
                {hasHeader && (
                    <header>
                        <slot name="header" />
                    </header>
                )}

                <main class="stack">
                    <slot />
                </main>

                {!hideFooter && (
                    <footer class="stack">
                        <a class="back-link" href="#top">
                            Scroll up
                        </a>

                        <SiteNav variant="footer" label="Footer navigation" />

                        <p>Designed and developed by Lukas Nabholz</p>
                    </footer>
                )}
            </div>
        </div>
    </body>
</html>

<style>
    body {
        min-height: 100dvh;
        margin: 0;
        padding: 0;
        isolation: isolate;
    }

    .page-content {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-5xl);
    }

    .content-boundary {
        box-sizing: border-box;
        inline-size: 100%;
        max-inline-size: 1920px;
        margin-inline: auto;
        padding: var(--spacing-lg) var(--padding-inline-page);
    }

    #animation-wrapper {
        position: relative;
        z-index: 1;
        background-color: var(--color-background);
        animation: slide-up var(--transition-duration-slow)
            var(--transition-timing-out) var(--animation-delay-short) both;
    }

    footer {
        gap: var(--spacing-xs);
        color: var(--color-text-faint);
        font-size: var(--font-size-sm);
        padding-block-start: var(--spacing-5xl);
    }

    .back-link {
        text-transform: uppercase;
        font-size: var(--font-size-sm);
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(var(--spacing-4xl));
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #animation-wrapper {
            animation: none;
        }
    }
</style>
