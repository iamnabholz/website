---
import "../styles/styles.css";
import SiteNav from "../components/SiteNav.astro";
import Sticker from "../components/Sticker.astro";

const { title, header } = Astro.props;

const DESCRIPTION = "Find the works and projects of Lukas Nabholz.";

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{title}</title>

        <meta name="author" content="Lukas Nabholz" />
        <meta name="description" content={DESCRIPTION} />
        <!-- other meta tags -->
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />
        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />

        <!-- Open Graph / Social meta tags -->
        <meta property="og:title" content={title} />
        <!-- other social meta tags -->
        <meta property="og:description" content={DESCRIPTION} />
        <meta
            property="og:image"
            content="https://nabholz.work/website_cover.png"
        />
        <meta
            property="og:image:alt"
            content="A sticker designed by Lukas Nabholz or a solid colored background."
        />

        <meta property="og:url" content="https://nabholz.work/" />
        <meta property="og:type" content="website" />

        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <!-- other link tags (excluding stylesheets and resource hints) -->
        <!-- Icons -->
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preconnect" href="https://nabholz.work/" />
        <link rel="dns-prefetch" href="https://nabholz.work/" />
    </head>
    <body class="stack">
        <header class="content stack">
            {currentPath.startsWith("/blog/") ? (
                ""
            ) : (
                <h1 class="title">
                    <b>Lukas Nabholz</b>
                    {" — "}
                    {header
                        ? header
                        : "Product designer and developer building    digital experiences that people actually enjoy using."}
                </h1>
            )}

            <SiteNav variant="header" label="Primary navigation" />
        </header>
        <span id="animation-wrapper">
            <main class="stack">
                <slot />
            </main>

            <footer>
                Fonts by{" "}
                <a target="_blank" href="https://pangrampangram.com/">
                    PangramPangram
                </a>
                <br />
                Designed and developed by Lukas Nabholz
            </footer>
        </span>
    </body>
</html>

<style>
    body {
        padding-block: var(--spacing-lg);
        min-height: 100dvh;
        gap: var(--spacing-4xl);
    }

    #animation-wrapper {
        display: contents;
        animation: slide-up 600ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
    }

    h1.title {
        font-weight: var(--font-weight-normal);
    }

    main {
        gap: var(--spacing-4xl);
        padding-block: var(--spacing-4xl);
    }

    footer {
        color: var(--color-text-faint);
        font-size: var(--font-size-sm);
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(var(--spacing-4xl));
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #animation-wrapper {
            animation: none;
        }
    }
</style>
