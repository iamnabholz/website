---
import "../styles/styles.css";
import SiteNav from "../components/SiteNav.astro";
import { ClientRouter } from "astro:transitions";
import Sticker from "../components/Sticker.astro";

const DEFAULT_DESCRIPTION = "Find the works and projects of Lukas Nabholz.";

interface Props {
    title: string;
    description?: string;
    hideFooter?: boolean;
    type?: "website" | "article";
    publishedTime?: Date;
}

const {
    title,
    description = DEFAULT_DESCRIPTION,
    hideFooter = false,
    type = "website",
    publishedTime,
} = Astro.props;

const finalTitle = `${title} — Lukas Nabholz`;

const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const canonicalURL = new URL(canonicalPath, Astro.site ?? Astro.url.origin);

const socialImageURL = new URL(
    "/website_cover.png",
    Astro.site ?? Astro.url.origin,
);

const socialImageAlt = "Lukas Nabholz — Product Designer & Developer";

const homepageURL = new URL("/", Astro.site ?? Astro.url.origin);

const person = {
    "@type": "Person",
    "@id": `${homepageURL.href}#person`,
    name: "Lukas Nabholz",
    url: homepageURL.href,
    jobTitle: "Product Designer & Developer",
    sameAs: [
        "https://www.threads.com/@nabholzwork",
        "https://bsky.app/profile/nabholz.work",
    ],
};

const structuredData =
    type === "article"
        ? {
              "@context": "https://schema.org",
              "@type": "BlogPosting",
              "@id": `${canonicalURL.href}#article`,
              url: canonicalURL.href,
              mainEntityOfPage: {
                  "@type": "WebPage",
                  "@id": canonicalURL.href,
              },
              headline: title,
              description,
              inLanguage: "en",
              author: person,
              ...(publishedTime && {
                  datePublished: publishedTime.toISOString(),
              }),
          }
        : Astro.url.pathname === "/"
          ? {
                "@context": "https://schema.org",
                ...person,
            }
          : undefined;

const structuredDataJSON = structuredData
    ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
    : undefined;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{finalTitle}</title>
        <link rel="canonical" href={canonicalURL.href} />

        <meta name="author" content="Lukas Nabholz" />
        <meta name="description" content={description} />

        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />

        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />
        <meta property="og:title" content={finalTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL.href} />

        <meta property="og:type" content={type} />
        {type === "article" && (
            <>
                {publishedTime && (
                    <meta
                        property="article:published_time"
                        content={publishedTime.toISOString()}
                    />
                )}
                <meta
                    property="article:author"
                    content={new URL("/", Astro.site ?? Astro.url.origin).href}
                />
            </>
        )}

        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <meta property="og:image" content={socialImageURL.href} />
        <meta property="og:image:alt" content={socialImageAlt} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={finalTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL.href} />
        <meta name="twitter:image:alt" content={socialImageAlt} />

        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        {structuredDataJSON && (
            <script
                is:inline
                type="application/ld+json"
                set:html={structuredDataJSON}
            />
        )}

        <ClientRouter />
    </head>

    <body id="top" class="site-shell">
        <header class="site-header">
            <div class="site-title">
                <strong class="site-title__name">Lukas Nabholz</strong>

                <span class="site-title__sticker">
                    <Sticker visualScale={1.6} />
                </span>
            </div>

            <SiteNav variant="header" label="Primary navigation" />
        </header>

        <div id="animation-wrapper">
            <main class="stack">
                <slot />
            </main>

            {!hideFooter && (
                <footer class="stack">
                    <a class="back-link" href="#top">
                        Scroll up
                    </a>

                    <SiteNav variant="footer" label="Footer navigation" />

                    <p>Designed and developed by me</p>
                </footer>
            )}
        </div>
    </body>
</html>

<style>
    body {
        min-block-size: 100dvh;
        margin: 0;
        padding: 0;
        isolation: isolate;
    }

    .site-shell {
        inline-size: 100%;
        max-inline-size: var(--max-width-page);
        margin-inline: auto;
        padding-block: var(--spacing-lg);
        padding-inline: var(--padding-inline-page);
    }

    .site-header {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);

        min-inline-size: 0;
        margin-inline: var(--text-indent-introduction);
    }

    .site-title {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-inline-size: 0;

        font-size: var(--font-size-site-title);
        line-height: var(--line-height-tight);
    }

    .site-title__name {
        min-inline-size: 0;

        color: inherit;
        font-weight: var(--font-weight-semibold);
        letter-spacing: -0.045em;
        text-decoration: none;
        white-space: nowrap;
    }

    .site-title__sticker {
        flex: 0 0 auto;
        margin-inline: 0.3em;
    }

    #animation-wrapper {
        position: relative;
        z-index: 1;
        background-color: var(--color-background);
        animation: slide-up var(--transition-duration-slow)
            var(--transition-timing-out) var(--animation-delay-short) both;
    }

    main {
        margin-block: var(--spacing-section);
        gap: var(--spacing-section);
    }

    footer {
        gap: var(--spacing-xs);
        color: var(--color-text-faint);
        font-size: var(--font-size-sm);
    }

    .back-link {
        text-transform: uppercase;
        font-size: var(--font-size-sm);
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(var(--spacing-4xl));
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #animation-wrapper {
            animation: none;
        }
    }
</style>
