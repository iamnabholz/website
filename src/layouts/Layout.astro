---
import "../styles/styles.css";
import Sticker from "../components/Sticker.astro";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{title}</title>

        <meta
            name="keywords"
            content="Designer, Developer, Web Developer, UX Design, UI Design, Apps, Software Design, Tools, Product Designer, UI/UX Design, Web Design, App Design, Graphic Design, Visual Design, Developer, Game Dev, User Experience Design, User Interface Design"
        />
        <meta name="author" content="Lukas Nabholz" />
        <meta
            name="description"
            content="Find the works and projects of Lukas Nabholz."
        />
        <!-- other meta tags -->
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />
        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />

        <!-- Open Graph / Social meta tags -->
        <meta property="og:title" content="Lukas Nabholz" />
        <!-- other social meta tags -->
        <meta property="og:description" content="Website of Lukas Nabholz" />
        <meta
            property="og:image"
            content="https://nabholz.work/website_cover.png"
        />
        <meta
            property="og:image:alt"
            content="A sticker designed by Lukas Nabholz or a solid colored background."
        />

        <meta property="og:url" content="https://nabholz.work/" />
        <meta property="og:type" content="website" />

        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <!-- other link tags (excluding stylesheets and resource hints) -->
        <!-- Icon in the highest resolution we need it for -->
        <link rel="icon" sizes="192x192" href="/apple-touch-icon.png" />

        <!-- Apple Touch Icon (reuse 192px icon.png) -->
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preconnect" href="https://nabholz.work/" />
        <link rel="dns-prefetch" href="https://nabholz.work/" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body>
        <header>
            <div class="content">
                <Sticker /> <Sticker /> <Sticker />
            </div>
        </header>

        <div id="animation-wrapper">
            <main>
                <slot />
            </main>

            <footer>
                <div class="content">
                    <p>
                        font by{" "}
                        <a target="_blank" href="https://pangrampangram.com/">
                            PangramPangram
                        </a>
                        <br />
                        &copy; 2026. Lukas Nabholz.
                    </p>
                </div>
            </footer>
        </div>
    </body>
</html>

<script>
    import { pickRandomColor } from "../lib/utils";
    document.documentElement.style.setProperty("--accent", pickRandomColor());
</script>

<style>
    body {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;

        font-size: var(--fs-lg);
    }

    #animation-wrapper {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: var(--space-24);
        animation: slide-up 600ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
    }

    header {
        padding: var(--space-16) 0 var(--space-10) 0;
    }

    main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    footer {
        padding: var(--space-16) 0 var(--space-24) 0;
        background: linear-gradient(
            0deg,
            var(--color-accent) 0%,
            transparent 100%
        );
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(64px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        main {
            animation: none;
        }
    }
</style>
