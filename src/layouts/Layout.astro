---
import "../styles/styles.css";

const { title } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{title}</title>

        <meta
            name="keywords"
            content="Designer, Developer, Web Developer, UX Design, UI Design, Apps, Software Design, Tools, Product Designer, UI/UX Design, Web Design, App Design, Graphic Design, Visual Design, Developer, Game Dev, User Experience Design, User Interface Design"
        />
        <meta name="author" content="Lukas Nabholz" />
        <meta
            name="description"
            content="Find the works and projects of Lukas Nabholz."
        />
        <!-- other meta tags -->
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />
        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />

        <!-- Open Graph / Social meta tags -->
        <meta property="og:title" content="Lukas Nabholz" />
        <!-- other social meta tags -->
        <meta property="og:description" content="Website of Lukas Nabholz" />
        <meta
            property="og:image"
            content="https://nabholz.work/website_cover.png"
        />
        <meta
            property="og:image:alt"
            content="A sticker designed by Lukas Nabholz or a solid colored background."
        />

        <meta property="og:url" content="https://nabholz.work/" />
        <meta property="og:type" content="website" />

        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <!-- other link tags (excluding stylesheets and resource hints) -->
        <!-- Icons -->
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preconnect" href="https://nabholz.work/" />
        <link rel="dns-prefetch" href="https://nabholz.work/" />
    </head>
    <body id="top">
        <div id="animation-wrapper">
            {!isHome && (
                <header class="content">
                    <a class="back-home" href="/">
                        Back home
                    </a>
                </header>
            )}
            <main>
                <slot />
            </main>

            <footer class="content stack">
                <a class="back-top" href="#top">
                    Back to top
                </a>
                <nav>
                    <a href="/">Work</a> <a href="/about">About</a>{" "}
                    <a href="/projects">Projects</a>
                </nav>
                <p>
                    Fonts by{" "}
                    <a target="_blank" href="https://pangrampangram.com/">
                        PangramPangram
                    </a>
                    <br />
                    &copy; 2026 Lukas Nabholz
                </p>
            </footer>
        </div>
    </body>
</html>

<script>
    import { pickRandomColor } from "../lib/utils";
    document.documentElement.style.setProperty(
        "--color-accent",
        pickRandomColor(),
    );
</script>

<style>
    body {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;

        font-size: var(--fs-lg);

        padding-block: var(--space-16);
    }

    #animation-wrapper {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: var(--space-12);
        animation: slide-up 600ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
    }

    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    nav {
        display: flex;
        gap: 0 var(--space-6);
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(64px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        main {
            animation: none;
        }
    }

    .back-home::before,
    .back-top::before {
        font-size: var(--fs-sm);
        font-weight: inherit;
        display: inline-block;
        transition: transform 120ms var(--ease-out);
    }

    .back-home::before {
        content: "\2190\00a0";
    }
    .back-top::before {
        content: "\2191\00a0";
    }
    .back-home:is(:hover, :active, :focus-visible)::before {
        transform: translateX(-3px);
    }

    .back-top:is(:hover, :active, :focus-visible)::before {
        transform: translateY(-3px);
    }
</style>
