---
import "../styles/styles.css";
import SiteNav from "../components/SiteNav.astro";
import { ClientRouter } from "astro:transitions";
import DitherCanvas from "../components/DitherCanvas.astro";

const { title, hideFooter = false } = Astro.props;

const hasHeader = Astro.slots.has("header");
const finalTitle = `${title} — Lukas Nabholz`;

const DESCRIPTION = "Find the works and projects of Lukas Nabholz.";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{finalTitle}</title>

        <meta name="author" content="Lukas Nabholz" />
        <meta name="description" content={DESCRIPTION} />
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />

        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={DESCRIPTION} />
        <meta
            property="og:image"
            content="https://nabholz.work/website_cover.png"
        />
        <meta
            property="og:image:alt"
            content="A sticker designed by Lukas Nabholz or a solid colored background."
        />
        <meta property="og:url" content="https://nabholz.work/" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preconnect" href="https://nabholz.work/" />
        <link rel="dns-prefetch" href="https://nabholz.work/" />

        <ClientRouter />
    </head>

    <body id="top">
        <nav
            class="site-navigation content-boundary"
            aria-label="Primary navigation"
        >
            <div class="site-navigation__links">
                <a class="site-navigation__link" href="/">
                    work
                </a>

                <a class="site-navigation__link" href="/about">
                    about
                </a>

                <a class="site-navigation__link" href="/blog">
                    blog
                </a>
            </div>
        </nav>

        <header class="site-header">
            <site-header-background
                class="site-header__background"
                aria-hidden="true"
            >
                <div class="site-header__dither-area" data-dither-mask></div>

                <DitherCanvas pixelSize={4} color="green" opacity={0.12} />
            </site-header-background>

            <div class="site-header__intro content-boundary">
                {hasHeader && <slot name="header" />}
            </div>
        </header>

        <div id="animation-wrapper">
            <div class="page-content content-boundary">
                <main class="stack">
                    <slot />
                </main>

                {!hideFooter && (
                    <footer class="stack">
                        <a class="back-link" href="#top">
                            Scroll up
                        </a>

                        <SiteNav variant="footer" label="Footer navigation" />

                        <p>Designed and developed by Lukas Nabholz</p>
                    </footer>
                )}
            </div>
        </div>

        <script>
            class SiteHeaderBackground extends HTMLElement {
                private resizeObserver?: ResizeObserver;

                connectedCallback() {
                    this.resizeObserver?.disconnect();

                    const header = this.closest<HTMLElement>(".site-header");

                    if (!header) return;

                    const updateHeight = () => {
                        this.style.setProperty(
                            "--site-header-height",
                            `${header.getBoundingClientRect().height}px`,
                        );
                    };

                    updateHeight();

                    this.resizeObserver = new ResizeObserver(updateHeight);
                    this.resizeObserver.observe(header);
                }

                disconnectedCallback() {
                    this.resizeObserver?.disconnect();
                    this.resizeObserver = undefined;
                }
            }

            if (!customElements.get("site-header-background")) {
                customElements.define(
                    "site-header-background",
                    SiteHeaderBackground,
                );
            }
        </script>
    </body>
</html>

<style>
    body {
        min-height: 100dvh;
        margin: 0;
        padding: 0;
        isolation: isolate;
    }

    /*
     * Shared width and padding for navigation, header content,
     * and the main page content.
     */
    .content-boundary {
        box-sizing: border-box;
        inline-size: 100%;
        max-inline-size: 1920px;
        margin-inline: auto;
        padding: var(--spacing-lg) var(--padding-inline-page);
    }

    /*
     * Fixed navigation
     */
    .site-navigation {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: 10;
    }

    .site-navigation__links {
        display: flex;
        align-items: center;
    }

    .site-navigation__link {
        color: var(--color-background);
        background-color: var(--color-text);
        padding: calc(var(--spacing-xs) + 0.08em) var(--spacing-lg)
            var(--spacing-xs);
        border-radius: 16px;
        margin-inline-end: -0.15em;
        text-decoration: none;
        text-transform: uppercase;
        font-size: var(--font-size-sm);
    }

    .site-navigation__link:hover {
        color: var(--color-text);
        background-color: var(--color-accent);
    }

    /*
     * Header layout
     *
     * The header remains in normal flow and reserves all of the space
     * required by the intro.
     */
    .site-header {
        position: relative;
        isolation: isolate;
        padding-block-start: 20svh;
        border-bottom: 1px solid var(--color-border);
    }

    /*
     * Fixed visual background.
     *
     * Its actual block size is synchronized with .site-header by the
     * custom element above. DitherCanvas can therefore continue sizing
     * itself from its parent as originally designed.
     */
    .site-header__background {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: 0;

        display: block;
        block-size: var(--site-header-height, 100svh);
        overflow: hidden;
        pointer-events: none;
    }

    /*
     * This is the region DitherCanvas uses as its drawing mask.
     */
    .site-header__dither-area {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    /*
     * The intro remains in normal document flow, so it scrolls normally.
     * position: relative is necessary for z-index to place it over the
     * dither canvas.
     */
    .site-header__intro {
        position: relative;
        z-index: 1;

        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);

        padding-block-start: var(--spacing-5xl);
    }

    .site-header__intro :global(.title) {
        margin: 0;
    }

    /*
     * The opaque page layer scrolls over the fixed header background.
     */
    #animation-wrapper {
        position: relative;
        z-index: 1;
        background-color: var(--color-background);
        animation: slide-up var(--transition-duration-slow)
            var(--transition-timing-out) var(--animation-delay-short) both;
    }

    main {
        gap: var(--spacing-4xl);
        padding-block: var(--spacing-lg);
    }

    footer {
        gap: var(--spacing-xs);
        color: var(--color-text-faint);
        font-size: var(--font-size-sm);
        padding-block-start: var(--spacing-5xl);
    }

    .back-link {
        text-transform: uppercase;
        font-size: var(--font-size-sm);
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(var(--spacing-4xl));
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #animation-wrapper {
            animation: none;
        }
    }
</style>
