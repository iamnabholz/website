---
import "../styles/styles.css";
import SiteNav from "../components/SiteNav.astro";
import Sticker from "../components/Sticker.astro";
import { ClientRouter } from "astro:transitions";

const { title, hideFooter = false } = Astro.props;

const DESCRIPTION = "Find the works and projects of Lukas Nabholz.";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{title}</title>

        <meta name="author" content="Lukas Nabholz" />
        <meta name="description" content={DESCRIPTION} />
        <!-- other meta tags -->
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />
        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />

        <!-- Open Graph / Social meta tags -->
        <meta property="og:title" content={title} />
        <!-- other social meta tags -->
        <meta property="og:description" content={DESCRIPTION} />
        <meta
            property="og:image"
            content="https://nabholz.work/website_cover.png"
        />
        <meta
            property="og:image:alt"
            content="A sticker designed by Lukas Nabholz or a solid colored background."
        />

        <meta property="og:url" content="https://nabholz.work/" />
        <meta property="og:type" content="website" />

        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <!-- other link tags (excluding stylesheets and resource hints) -->
        <!-- Icons -->
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preconnect" href="https://nabholz.work/" />
        <link rel="dns-prefetch" href="https://nabholz.work/" />

        <ClientRouter />
    </head>
    <body>
        <header id="title" class="content">
            <SiteNav variant="header" label="Primary navigation" />
        </header>
        <div id="animation-wrapper" class="content">
            <main class="stack">
                <slot />
            </main>

            {hideFooter ? (
                ""
            ) : (
                <footer class="stack">
                    <a href="#title">Scroll up</a>
                    <SiteNav variant="footer" label="Footer navigation" />
                    <p>
                        Fonts by{" "}
                        <a target="_blank" href="https://pangrampangram.com/">
                            PangramPangram
                        </a>
                        <br />
                        Designed and developed by Lukas Nabholz
                    </p>
                </footer>
            )}
        </div>
    </body>
</html>

<style>
    body {
        max-width: 1920px;
        min-height: 100dvh;
        margin: 0 auto;
        padding: var(--spacing-lg);
    }

    #animation-wrapper {
        animation: slide-up 600ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
    }

    main {
        gap: var(--spacing-4xl);
        padding-block: var(--spacing-4xl);
    }

    footer {
        gap: var(--spacing-xs);
        color: var(--color-text-faint);
        font-size: var(--font-size-sm);
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(var(--spacing-4xl));
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #animation-wrapper {
            animation: none;
        }
    }
</style>
