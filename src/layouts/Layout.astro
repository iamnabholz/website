---
import "../styles/styles.css";
import SiteNav from "../components/SiteNav.astro";
import { ClientRouter } from "astro:transitions";
import Sticker from "../components/Sticker.astro";

const DEFAULT_DESCRIPTION = "Find the works and projects of Lukas Nabholz.";

const {
    title,
    description = DEFAULT_DESCRIPTION,
    hideFooter = false,
} = Astro.props;

const finalTitle = `${title} — Lukas Nabholz`;

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site ?? Astro.url.origin,
);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />

        <title>{finalTitle}</title>
        <link rel="canonical" href={canonicalURL.href} />

        <meta name="author" content="Lukas Nabholz" />
        <meta name="description" content={description} />

        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />

        <meta
            name="p:domain_verify"
            content="37e98c1a1875e0741fc3abdea1aaf180"
        />

        <meta property="og:title" content={finalTitle} />
        <meta property="og:description" content={description} />

        <meta
            property="og:image"
            content="https://nabholz.work/website_cover.png"
        />
        <meta
            property="og:image:alt"
            content="A sticker designed by Lukas Nabholz or a solid colored background."
        />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Lukas Nabholz" />
        <meta property="og:locale" content="en_US" />

        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <ClientRouter />
    </head>

    <body id="top" class="site-shell">
        <header class="site-header">
            <div class="site-title">
                <strong class="site-title__name">Lukas Nabholz</strong>

                <span class="site-title__sticker">
                    <Sticker visualScale={1.6} />
                </span>
            </div>

            <SiteNav variant="header" label="Primary navigation" />
        </header>

        <div id="animation-wrapper">
            <main class="stack">
                <slot />
            </main>

            {!hideFooter && (
                <footer class="stack">
                    <a class="back-link" href="#top">
                        Scroll up
                    </a>

                    <SiteNav variant="footer" label="Footer navigation" />

                    <p>Designed and developed by me</p>
                </footer>
            )}
        </div>
    </body>
</html>

<style>
    body {
        min-block-size: 100dvh;
        margin: 0;
        padding: 0;
        isolation: isolate;
    }

    .site-shell {
        inline-size: 100%;
        max-inline-size: var(--max-width-page);
        margin-inline: auto;
        padding-block: var(--spacing-lg);
        padding-inline: var(--padding-inline-page);
    }

    .site-header {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);

        min-inline-size: 0;
        margin-inline: var(--text-indent-introduction);
    }

    .site-title {
        display: flex;
        align-items: center;
        justify-content: space-between;

        min-inline-size: 0;

        font-size: var(--font-size-site-title);
        line-height: var(--line-height-tight);
    }

    .site-title__name {
        min-inline-size: 0;

        color: inherit;
        font-weight: var(--font-weight-semibold);
        letter-spacing: -0.045em;
        text-decoration: none;
        white-space: nowrap;
    }

    .site-title__sticker {
        flex: 0 0 auto;
        margin-inline: 0.3em;
    }

    #animation-wrapper {
        position: relative;
        z-index: 1;
        background-color: var(--color-background);
        animation: slide-up var(--transition-duration-slow)
            var(--transition-timing-out) var(--animation-delay-short) both;
    }

    main {
        margin-block: var(--spacing-section);
        gap: var(--spacing-section);
    }

    footer {
        gap: var(--spacing-xs);
        color: var(--color-text-faint);
        font-size: var(--font-size-sm);
    }

    .back-link {
        text-transform: uppercase;
        font-size: var(--font-size-sm);
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(var(--spacing-4xl));
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #animation-wrapper {
            animation: none;
        }
    }
</style>
