---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import worksData from "../content/works.json";

interface Work {
    title: string;
    href?: string | null;
    cover?: string | null;
}

const works = worksData as Work[];

const coverImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/content/media/**/*.{png,jpg,jpeg,webp,avif}",
    {
        eager: true,
    },
);

function resolveCover(path: string): ImageMetadata {
    /*
     * JSON:       /register/home.webp
     * Source key: /src/content/media/register/home.webp
     */
    const sourcePath = `/src/content/media${path}`;
    const image = coverImages[sourcePath];

    if (!image) {
        throw new Error(
            `Project cover not found: ${path} (expected ${sourcePath})`,
        );
    }

    return image.default;
}
---

<div class="works-feed">
    <div class="works-grid">
        {works.map((work) => {
            const Tag = work.href ? "a" : "div";
            const cover = work.cover ? resolveCover(work.cover) : null;

            return (
                <Tag class="work-card" href={work.href ?? undefined}>
                    <figure class="work-figure">
                        <div class="work-media">
                            {cover ? (
                                <Image
                                    class="work-image"
                                    src={cover}
                                    alt=""
                                    widths={[176, 352, 528]}
                                    sizes="
                                            (max-width: 520px) 42vw,
                                            (max-width: 800px) 28vw,
                                            176px
                                        "
                                    loading="lazy"
                                    decoding="async"
                                />
                            ) : (
                                <span
                                    class="work-placeholder"
                                    aria-hidden="true"
                                />
                            )}
                        </div>

                        <figcaption class="work-title">{work.title}</figcaption>
                    </figure>
                </Tag>
            );
        })}
    </div>
</div>

<style>
    .works-feed {
        width: 100%;
    }

    .works-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        align-items: start;
        column-gap: clamp(1rem, 2.5vw, 3rem);
        row-gap: clamp(3rem, 7vw, 7rem);
        width: 100%;
    }

    /*
     * This width declaration is essential. It overrides the global
     * `a { width: fit-content }` rule that was shrinking linked cards.
     */
    .work-card {
        display: block;
        width: 100%;
        min-width: 0;
        color: inherit;
        text-decoration: none;
        white-space: normal;
    }

    a.work-card:is(:hover, :active, :focus-visible) {
        color: inherit;
    }

    /* Remove the global external-link arrow from work cards. */
    a.work-card[href^="http"]::after {
        content: none;
    }

    .work-card:focus-visible {
        border-radius: var(--border-radius-xs);
        outline-offset: var(--spacing-xs);
    }

    .work-figure {
        display: block;
        width: 100%;
        min-width: 0;
        margin: 0;
    }

    /*
     * Every card gets the exact same media height.
     * Images cannot change this height or move the caption.
     */
    .work-media {
        display: grid;
        place-items: center;
        width: 100%;
        height: 10rem;
        overflow: hidden;
    }

    /*
     * Every image gets the same 176 × 128px contain-box.
     *
     * Landscape images use the available width.
     * Square images use the available height.
     * Portrait images use the available height.
     * Nothing is cropped.
     */
    .work-media > :global(.work-image) {
        display: block;
        width: min(82%, 12rem);
        height: 10rem;
        max-width: none;
        object-fit: contain;
        object-position: center;
    }

    .work-placeholder {
        display: block;
        width: 5rem;
        max-width: 45%;
        aspect-ratio: 1;
        border: var(--border-width-thin) solid var(--color-border);
    }

    /*
     * Since every .work-media is exactly 11rem tall, every title
     * starts at precisely the same vertical position.
     */
    .work-title {
        min-width: 0;
        min-height: 1.2em;
        margin: var(--spacing-sm) 0 0;
        color: var(--color-text-faint);
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-normal);
        line-height: var(--line-height-tight);
        text-align: center;
        text-wrap: pretty;
    }

    /*
     * Keep five columns on normal desktop/tablet widths, as in the
     * reference. Switch directly to three only when they become cramped.
     */
    @media (max-width: 800px) {
        .works-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            column-gap: var(--spacing-md);
            row-gap: var(--spacing-3xl);
        }

        .work-media > :global(.work-image) {
            width: min(84%, 9rem);
            height: 7rem;
        }
    }

    @media (max-width: 520px) {
        .works-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: var(--spacing-sm);
        }

        .work-media {
            height: 8rem;
        }

        .work-media > :global(.work-image) {
            width: min(86%, 8rem);
            height: 6.5rem;
        }
    }

    @media (max-width: 300px) {
        .works-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
