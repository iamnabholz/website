<span class="current-time">
    <time aria-live="off">--:--</time>
</span>

<script>
    const formatter = new Intl.DateTimeFormat("default", {
        timeZone: "America/La_Paz",
        hour: "2-digit",
        minute: "2-digit",
        hour12: true,
    });

    function updateTime(el: HTMLTimeElement) {
        const now = new Date();
        el.dateTime = now.toISOString();
        el.textContent = formatter.format(now);
    }

    document
        .querySelectorAll<HTMLTimeElement>(".current-time time")
        .forEach((el) => {
            updateTime(el);
            const timerId = setInterval(() => updateTime(el), 30_000);
            document.addEventListener(
                "astro:before-swap",
                () => clearInterval(timerId),
                { once: true },
            );
        });
</script>

<style>
    .current-time {
        font-weight: var(--fw-bold);
        font-size: var(--fs-sm);
        position: relative;
        padding-left: 0.6em;
        color: color-mix(in srgb, currentColor 60%, transparent);
    }

    .current-time::before {
        content: "";
        position: absolute;
        left: 0;
        top: calc(50% - 0.3em);
        width: 0.4em;
        height: 0.4em;
        border-radius: 50%;
        background: currentColor;
    }
</style>
