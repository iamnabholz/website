<time class="current-time" aria-live="off">
    --:--
</time>

<script>
    const formatter = new Intl.DateTimeFormat("default", {
        timeZone: "America/La_Paz",
        hour: "2-digit",
        minute: "2-digit",
        hour12: true,
    });

    function updateTime(element: HTMLTimeElement) {
        const now = new Date();

        element.dateTime = now.toISOString();
        element.textContent = formatter.format(now);
    }

    document.addEventListener("astro:page-load", () => {
        document
            .querySelectorAll<HTMLTimeElement>("time.current-time")
            .forEach((time) => {
                updateTime(time);
                time.dataset.ready = "";

                const timerId = window.setInterval(
                    () => updateTime(time),
                    30_000,
                );

                document.addEventListener(
                    "astro:before-swap",
                    () => window.clearInterval(timerId),
                    { once: true },
                );
            });
    });
</script>

<style>
    .current-time {
        display: inline-block;
    }

    .current-time[data-ready] {
        position: relative;
        padding-inline-start: 0.6em;
    }

    .current-time[data-ready]::before {
        content: "";
        position: absolute;
        inset-inline-start: 0;
        inset-block-end: calc(50% - 0.2em);

        inline-size: 0.36em;
        block-size: 0.36em;

        border-radius: var(--border-radius-full);
        background-color: var(--color-text-faint);
        opacity: 0;

        animation: blink 2s step-end infinite;
    }

    @keyframes blink {
        50% {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .current-time[data-ready]::before {
            animation: none;
            opacity: 1;
        }
    }
</style>
