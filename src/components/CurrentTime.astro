<span class="current-time">--:--</span>

<script>
    const formatter = new Intl.DateTimeFormat("default", {
        timeZone: "America/La_Paz",
        hour: "2-digit",
        minute: "2-digit",
        hour12: true,
    });

    function updateTime(el: HTMLTimeElement) {
        const now = new Date();
        el.dateTime = now.toISOString();
        el.textContent = formatter.format(now);
    }

    document.addEventListener("astro:page-load", () => {
        document
            .querySelectorAll<HTMLElement>(".current-time")
            .forEach((container) => {
                const time = document.createElement("time");
                time.setAttribute("aria-live", "off");

                updateTime(time);
                container.replaceChildren(time);
                container.dataset.ready = "";

                const timerId = setInterval(() => updateTime(time), 30_000);

                document.addEventListener(
                    "astro:before-swap",
                    () => clearInterval(timerId),
                    { once: true },
                );
            });
    });
</script>

<style>
    .current-time {
        display: inline-block;
    }

    .current-time[data-ready] {
        position: relative;
        padding-left: 0.6em;
    }

    .current-time[data-ready]::before {
        content: "";
        position: absolute;
        left: 0;
        bottom: calc(50% - 0.2em);
        width: 0.36em;
        height: 0.36em;
        border-radius: 50%;
        background: var(--color-text-faint);
        opacity: 0;
        animation: blink 2s step-end infinite;
    }

    @keyframes blink {
        50% {
            opacity: 1;
        }
    }
</style>
