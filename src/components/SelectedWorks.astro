---
import { Image } from "astro:assets";
import works from "../content/selected-works.json";
import DitherCanvas from "./DitherCanvas.astro";

const allImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/**/*.{jpeg,jpg,png,gif,webp,avif}",
    { eager: true },
);

function resolveImage(src: string) {
    const key = src.replace(/^\.\//, "/src/");
    const mod = allImages[key];

    if (!mod) throw new Error(`Image not found: ${src}`);

    return mod.default;
}
---

<section>
    <DitherCanvas pixelSize={3} />

    <span class="content">
        <h2>Selected Projects</h2>
    </span>

    <div class="works">
        {works.map((work) => (
            <article>
                <a class="image-wrapper" href={work.href} data-dither-mask>
                    <Image src={resolveImage(work.image)} alt={work.title} />
                </a>
            </article>
        ))}
    </div>
</section>

<style>
    section {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
    }

    .works {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--spacing-sm);
    }

    @media screen and (min-width: 900px) {
        .works {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    article {
        background-color: lightgray;
    }

    .image-wrapper {
        position: relative;
        z-index: 1;
        height: clamp(18rem, 50vw, 32.5rem);
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(var(--spacing-md), 3vw, var(--spacing-xl));
    }

    .image-wrapper:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: -4px;
    }

    .image-wrapper img {
        height: 100%;
        width: auto;
        display: block;
        object-fit: contain;
    }
</style>
