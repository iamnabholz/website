---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import worksData from "../content/works.json";

interface Work {
    title: string;
    href?: string | null;
    cover?: string | null;
}

const works = worksData as Work[];

const coverImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/content/media/**/*.{png,jpg,jpeg,webp,avif}",
    {
        eager: true,
    },
);

function resolveCover(path: string): ImageMetadata {
    /*
     * JSON:       /media/register/home.webp
     * Source key: /src/content/media/register/home.webp
     */
    const sourcePath = `/src/content/media${path}`;
    const image = coverImages[sourcePath];

    if (!image) {
        throw new Error(
            `Project cover not found: ${path} (expected ${sourcePath})`,
        );
    }

    return image.default;
}
---

<div class="projects-feed">
    <div class="projects-grid">
        {works.map((work) => {
            const Tag = work.href ? "a" : "div";
            const cover = work.cover ? resolveCover(work.cover) : null;

            return (
                <Tag
                    class="project-card"
                    href={work.href ?? undefined}
                    aria-label={work.href ? `Open ${work.title}` : undefined}
                >
                    <span class="project-art" aria-hidden="true">
                        {cover ? (
                            <Image
                                class="project-cover"
                                src={cover}
                                alt=""
                                widths={[320, 640, 960]}
                                sizes="
                                    (max-width: 380px) 100vw,
                                    (max-width: 720px) 50vw,
                                    (max-width: 1100px) 33vw,
                                    25vw
                                "
                                loading="lazy"
                                decoding="async"
                            />
                        ) : (
                            <span class="placeholder"></span>
                        )}
                    </span>
                </Tag>
            );
        })}
    </div>
</div>

<style>
    .projects-feed {
        inline-size: 100%;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--padding-inline-page);
    }

    .project-card {
        display: block;
        inline-size: 100%;
        color: inherit;
        text-decoration: none;
    }

    a.project-card {
        cursor: pointer;
    }

    a.project-card:is(:hover, :active, :focus-visible) {
        color: inherit;
    }

    /* Remove the global external-link arrow from project cards. */
    a.project-card[href^="http"]::after {
        content: none;
    }

    .project-card:focus-visible {
        border-radius: var(--border-radius-md);
        outline-offset: var(--spacing-2xs);
    }

    .project-art {
        --art-primary: red;

        position: relative;
        display: grid;
        place-items: center;
        inline-size: 100%;
        aspect-ratio: 6 / 7;
        overflow: hidden;
        background-color: var(--color-surface-card);
        isolation: isolate;
    }

    .project-art > :global(.project-cover) {
        position: relative;
        z-index: 2;
        inline-size: 100%;
        block-size: 100%;
        object-fit: contain;
    }

    .placeholder {
        position: absolute;
        inset: 0;
        overflow: hidden;
        background-color: var(--art-primary);
    }

    .placeholder__shape {
        position: absolute;
        display: block;
    }

    @media (max-width: 1100px) {
        .projects-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 720px) {
        .projects-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--spacing-xs);
        }
    }

    @media (max-width: 380px) {
        .projects-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
