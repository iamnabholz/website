---
import SlugPattern from "./SlugPattern.astro";

interface Props {
    title: string;
    idPrefix: string;
    trailingGap?: string;
}

const { title, idPrefix, trailingGap = "0.12em" } = Astro.props;

const words = title.trim().split(/\s+/);
---

<span
    class="pattern-title"
    style={`--title-pattern-gap: ${trailingGap};`}
    aria-hidden="true"
>
    {words.map((word, index) => (
        <span class="title-segment">
            <span class="title-word">{word}</span>

            <span class="title-pattern">
                <SlugPattern
                    id={`${idPrefix}-tile-${index}`}
                    class="title-pattern-svg"
                />
            </span>
        </span>
    ))}
</span>

<style>
    .pattern-title {
        display: flex;
        flex-wrap: wrap;
        column-gap: 0.12em;
        row-gap: 0;
    }

    .title-segment {
        display: inline-flex;
        flex: 1 0 auto;
        align-items: baseline;
        min-inline-size: 0;
        max-inline-size: 100%;
        gap: var(--title-pattern-gap);
    }

    .title-word {
        min-inline-size: 0;
        overflow-wrap: anywhere;
    }

    .title-pattern {
        display: block;
        flex: 1 0 0.45cap;
        block-size: 1cap;
        align-self: baseline;
        overflow: hidden;
        opacity: 0.35;
    }

    .title-pattern :global(.title-pattern-svg) {
        display: block;
        inline-size: 100%;
        block-size: 100%;
    }
</style>
