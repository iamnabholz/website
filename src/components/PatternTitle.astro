---
import SlugPattern from "./SlugPattern.astro";

interface Props {
    title: string;
    idPrefix: string;
    arrow?: "none" | "flow" | "end";
    fill?: boolean;
}

const { title, idPrefix, arrow = "none", fill = true } = Astro.props;

const words = title.trim().split(/\s+/);

const items = [
    ...words.map((word) => ({ word, isArrow: false })),
    ...(arrow !== "none" ? [{ word: "", isArrow: true }] : []),
];
---

<span
    class:list={["pattern-title", { "pattern-title-compact": !fill }]}

    style="--title-pattern-gap: 0.12em;"
    aria-hidden="true"
>
    {items.map((item, index) => {
        const isEndArrow = item.isArrow && arrow === "end";

        return (
            <span
                class:list={[
                    "title-segment",
                    { "title-segment-end": isEndArrow },
                    {
                        "title-segment-before-arrow":
                            arrow === "end" && index === items.length - 2,
                        "title-segment-flow-arrow":
                            item.isArrow && arrow === "flow",
                    },
                ]}
            >
                {item.isArrow && arrow === "flow" && (
                    <span class="title-baseline">H</span>
                )}

                {item.isArrow ? (
                    <span class="title-arrow">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                        >
                            <path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z" />
                        </svg>
                    </span>
                ) : (
                    <span class="title-word">{item.word}</span>
                )}

                {!isEndArrow && (fill || index < items.length - 1) && (
                    <span class="title-pattern">
                        <SlugPattern
                            id={`${idPrefix}-tile-${index}`}
                            class="title-pattern-svg"
                        />
                    </span>
                )}
            </span>
        );
    })}
</span>

<style>
    .pattern-title {
        display: flex;
        flex-wrap: wrap;
        column-gap: 0.12em;
        row-gap: 0;
        margin: 0;
        font-size: inherit;
        font-weight: var(--font-weight-normal);
        line-height: var(--line-height-none);
        letter-spacing: var(--letter-spacing-tight);
        text-transform: uppercase;
        text-wrap: wrap;
        overflow-wrap: anywhere;
        overflow: hidden;
    }

    .title-segment {
        display: inline-flex;
        flex: 1 0 auto;
        align-items: baseline;
        min-inline-size: 0;
        max-inline-size: 100%;
        gap: var(--title-pattern-gap);
    }

    .title-segment-end {
        flex: 0 0 auto;
        margin-inline-start: auto;
    }

    .title-segment-end .title-arrow {
        position: relative;
        inset-block-start: 0.22cap;
    }

    .title-word {
        min-inline-size: 0;
        overflow-wrap: anywhere;
    }

    .title-pattern {
        position: relative;
        flex: 1 0 1cap;
        inline-size: 1cap;
        min-inline-size: 1cap;
        block-size: 1cap;
        overflow: hidden;
        opacity: 0.35;
    }

    .title-pattern :global(.title-pattern-svg) {
        position: absolute;
        inset: 0;
        display: block;
        inline-size: 100%;
        block-size: 100%;
    }

    .title-arrow {
        display: inline-block;
        flex: 0 0 auto;
        inline-size: 1.5cap;
        block-size: 1cap;
    }

    .title-arrow svg {
        display: block;
        inline-size: 100%;
        block-size: 100%;
        overflow: visible;
    }

    .pattern-title-compact .title-segment {
        flex-grow: 0;
    }

    .pattern-title-compact .title-pattern {
        flex-grow: 0;
    }

    .pattern-title-compact .title-segment-before-arrow {
        flex-grow: 1;
    }

    .pattern-title-compact .title-segment-before-arrow .title-pattern {
        flex-grow: 1;
    }
    .title-baseline {
        flex: 0 0 0;
        inline-size: 0;
        visibility: hidden;
        overflow: hidden;
    }

    .title-segment-flow-arrow .title-arrow {
        line-height: 0;
    }
</style>
