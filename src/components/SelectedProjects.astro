---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import DitherCanvas from "./DitherCanvas.astro";

const SELECTED_NOTES = (
    await getCollection("notes", ({ data }) => data.selected === true)
).sort((a, b) => {
    const dateA = a.data.date?.valueOf() ?? 0;
    const dateB = b.data.date?.valueOf() ?? 0;

    return dateB - dateA;
});

const allImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/**/*.{jpeg,jpg,png,gif,webp,avif}",
    { eager: true },
);

function resolveImage(src: string) {
    const key = src.replace(/^\.\//, "/src/");
    const mod = allImages[key];

    if (!mod) throw new Error(`Image not found: ${src}`);

    return mod.default;
}
---

<div class="container">
    <DitherCanvas pixelSize={3} />

    <div class="works">
        {SELECTED_NOTES.map((work) => {
            return (
                <article>
                    <a
                        class="image-wrapper"
                        href={`/blog/${work.id}`}
                        data-dither-mask
                    >
                        <div class="work-preview">
                            <div class="work-image">
                                <Image
                                    src={resolveImage(work.data.image)}
                                    alt={work.data.title}
                                />
                            </div>
                            <h3 class="work-title">{work.data.project}</h3>
                        </div>
                    </a>
                </article>
            );
        })}
    </div>
</div>

<style>
    .container {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
    }

    .works {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--spacing-sm);
    }

    @media screen and (min-width: 900px) {
        .works {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    article {
        background-color: var(--color-surface-card);
    }

    .image-wrapper {
        --card-height: clamp(16rem, 50vw, 30rem);
        --card-padding: clamp(1.4rem, 4vw, 4rem);

        position: relative;
        z-index: 1;
        box-sizing: border-box;
        height: var(--card-height);
        width: 100%;
        display: block;
        padding: var(--card-padding);
        color: var(--color-text-black);
        text-decoration: none;
        cursor: pointer;
        transition: none;
    }

    .image-wrapper:is(:hover, :active, :focus-visible) {
        color: var(--color-text-black);
        text-decoration: none;
    }

    .image-wrapper:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: -4px;
    }

    .work-preview {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: minmax(0, 1fr) auto;
        gap: var(--spacing-md);
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
    }

    .work-image {
        position: relative;
        min-width: 0;
        min-height: 0;
    }

    .work-image img {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .work-title {
        align-self: center;
        justify-self: center;
        max-inline-size: 100%;
        margin: 0;
        color: var(--color-text-black);
        text-align: center;
        overflow-wrap: anywhere;
    }
</style>
