---
interface Props {
    /** Base visual size; never increases line height. */
    size?: string;
    /** Visual multiplier. Text reserves only 5/6 of the resulting width. */
    visualScale?: number;
    /** Initial sticker filename without .svg; otherwise random. */
    sticker?: string;
}

const { size = "1em", visualScale = 1, sticker } = Astro.props;
---

<span
    class="sticker-space"
    style={`--sticker-size:calc(${size} * ${visualScale});`}
>
    <button
        type="button"
        class="sticker-wrapper"
        data-initial={sticker}
        aria-label="Change decorative sticker"
    >
        <span class="sticker" aria-hidden="true"></span>
    </button>
</span>

<script>
    const modules = import.meta.glob<string>("/src/content/stickers/*.svg", {
        eager: true,
        query: "?raw",
        import: "default",
    });
    const stickers = Object.values(modules);
    const colors = [
        "#fcc010",
        "#f4971b",
        "#e9473a",
        "#cd2e55",
        "#f6bcd0",
        "#dedcdd",
        "#9dbfae",
        "#8dc04e",
        "#13955f",
        "#627e8b",
        "#4153a1",
        "#438ecc",
        "#1eb8d1",
        "#088ea7",
    ];

    function pickDifferent(pool: string[], previous?: string) {
        const choices = pool.filter((item) => item !== previous);
        return choices[Math.floor(Math.random() * choices.length)] ?? pool[0];
    }

    document.addEventListener("astro:page-load", () => {
        document
            .querySelectorAll<HTMLElement>(".sticker-wrapper")
            .forEach((button) => {
                const artwork = button.querySelector<HTMLElement>(".sticker");
                if (!artwork || !stickers.length) return;
                let lastSticker: string;
                let color: string;

                function change(initial?: string) {
                    lastSticker =
                        initial ?? pickDifferent(stickers, lastSticker);
                    color = pickDifferent(colors, color);
                    button.style.setProperty("--sticker", color);
                    button.style.setProperty(
                        "--rotation",
                        `${Math.random() * 16 - 8}deg`,
                    );
                    button.style.setProperty(
                        "--scale",
                        `${0.92 + Math.random() * 0.16}`,
                    );
                    button.style.setProperty(
                        "--x",
                        `${Math.random() * 4 - 2}%`,
                    );
                    button.style.setProperty(
                        "--y",
                        `${Math.random() * 4 - 2}%`,
                    );
                    // A fresh SVG restarts the pop animation, even on rapid clicks.
                    artwork!.innerHTML = lastSticker;
                }

                change(
                    modules[
                        `/src/content/stickers/${button.dataset.initial}.svg`
                    ],
                );
                button.addEventListener("click", () => change());
            });
    });
</script>

<style>
    .sticker-space {
        /* Reserve width only; the artwork stays outside the line box. */
        position: relative;
        display: inline-block;
        width: calc(var(--sticker-size) * 5 / 6);
        height: 0;
        line-height: 0;
        vertical-align: baseline;
        overflow: visible;
    }

    .sticker-wrapper {
        all: unset;
        position: absolute;
        z-index: 1;
        left: 50%;
        top: -0.345em;
        width: var(--sticker-size);
        height: var(--sticker-size);
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        transform: translate(
                calc(-50% + var(--x, 0%)),
                calc(-50% + var(--y, 0%))
            )
            rotate(var(--rotation, 0deg)) scale(var(--scale, 1));
    }

    .sticker-wrapper:focus-visible {
        border-radius: var(--border-radius-xs);
        outline: var(--outline-width-focus) solid currentColor;
        outline-offset: var(--outline-offset-focus);
    }

    .sticker {
        display: block;

        width: 100%;
        height: 100%;

        color: black;
        filter: drop-shadow(var(--box-shadow-md));
        pointer-events: none;

        transition: transform var(--transition-duration-fast)
            var(--transition-timing-out);
    }

    .sticker-wrapper:hover .sticker {
        transform: scale(1.16);
    }

    .sticker-wrapper:active .sticker {
        transform: scale(1.12, 0.85);
    }

    .sticker :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
        transform-origin: center;
        animation: sticker-pop 180ms ease-out;
    }

    @keyframes sticker-pop {
        0% {
            transform: scale(1.18, 0.78);
        }
        45% {
            transform: translateY(-8%) scale(0.88, 1.16);
        }
        75% {
            transform: scale(1.05, 0.95);
        }
        100% {
            transform: scale(1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .sticker-wrapper {
            transform: translate(-50%, -50%);
        }

        .sticker-wrapper:is(:hover, :active) .sticker {
            transform: none;
        }

        .sticker {
            transition: none;
        }

        .sticker :global(svg) {
            animation: none;
        }
    }
</style>
