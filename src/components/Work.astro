---
interface Props {
    title: string;
    tagline: string;
    href?: string;
}

const { title, tagline, href } = Astro.props;
---

<article class="stack">
    <header class="content stack">
        <h2 class="prose">
            <b>{title}:</b> {tagline.toLowerCase()}
        </h2>
        {href && (
            <a href={href} aria-label={`Read about ${title}`}>
                read post
            </a>
        )}
    </header>

    <slot />
</article>

<style>
    h2 {
        font-weight: var(--fw-normal);
        font-size: var(--fs-xl);
    }
</style>
