---
interface Props {
    id: string;
    class?: string;
}

const { id, class: className } = Astro.props;

const diagonal = [
    "10001000",
    "01000100",
    "00100010",
    "00010001",
    "10001000",
    "01000100",
    "00100010",
    "00010001",
];

const pixelSize = 2;
const tileSize = diagonal.length * pixelSize;
const paths: string[] = [];

diagonal.forEach((row, y) => {
    for (let x = 0; x < row.length; x++) {
        if (row[x] !== "1") continue;

        paths.push(
            `M${x * pixelSize} ${y * pixelSize}` +
                `h${pixelSize}v${pixelSize}h-${pixelSize}z`,
        );
    }
});
---

<svg
    class={className}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
    shape-rendering="crispEdges"
>
    <defs>
        <pattern
            id={id}
            width={tileSize}
            height={tileSize}
            patternUnits="userSpaceOnUse"
        >
            <path d={paths.join("")} fill="currentColor" />
        </pattern>
    </defs>

    <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
