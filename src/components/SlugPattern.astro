---
import type { PostPattern } from "../lib/postPatterns";

interface Props {
    id: string;
    class?: string;
    pattern?: PostPattern;
}

const { id, class: className, pattern: selected = "pixels" } = Astro.props;

const tiles: Record<PostPattern, readonly string[]> = {
    pixels: [
        "10001000",
        "00000000",
        "00100010",
        "00000000",
        "10001000",
        "00000000",
        "00100010",
        "00000000",
    ],

    diagonal: [
        "10001000",
        "01000100",
        "00100010",
        "00010001",
        "10001000",
        "01000100",
        "00100010",
        "00010001",
    ],
    chevrons: [
        "10001000",
        "01000100",
        "00100010",
        "01000100",
        "10001000",
        "01000100",
        "00100010",
        "01000100",
    ],

    crosses: [
        "01000000",
        "11100000",
        "01000000",
        "00000000",
        "00000100",
        "00001110",
        "00000100",
        "00000000",
    ],

    tetrominoes: [
        "10100000",
        "01000000",
        "10100000",
        "00000000",
        "00001010",
        "00000100",
        "00001010",
        "00000000",
    ],
};

const pixelSize = 2;
const tileSize = 8 * pixelSize;
const paths: string[] = [];

tiles[selected].forEach((row, y) => {
    for (let x = 0; x < row.length; x++) {
        if (row[x] !== "1") continue;

        paths.push(
            `M${x * pixelSize} ${y * pixelSize}` +
                `h${pixelSize}v${pixelSize}h-${pixelSize}z`,
        );
    }
});
---

<svg
    class={className}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
    shape-rendering="crispEdges"
>
    <defs>
        <pattern
            id={id}
            width={tileSize}
            height={tileSize}
            patternUnits="userSpaceOnUse"
        >
            <path d={paths.join("")} fill="currentColor" />
        </pattern>
    </defs>

    <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
