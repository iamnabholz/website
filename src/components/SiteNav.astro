---
interface Props {
    variant: "header" | "footer";
    label: string;
}

const { variant, label } = Astro.props;

const HEADER_LINKS = [
    { href: "/", label: "Works" },
    { href: "/feed", label: "Feed" },
    { href: "/blog", label: "Blog" },
];

const FOOTER_LINKS = [
    { href: "/", label: "works" },
    { href: "/feed", label: "feed" },
    { href: "/blog", label: "blog" },
];

const links = variant === "header" ? HEADER_LINKS : FOOTER_LINKS;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
    if (href === "/") {
        return currentPath === "/";
    }

    return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<nav aria-label={label} data-variant={variant} class="content-boundary">
    {links.map(({ href, label: linkLabel }, index) => (
        <Fragment>
            <a
                href={href}
                aria-current={currentPath === href ? "page" : undefined}
                data-active={isActive(href) ? "" : undefined}
            >
                {linkLabel}
            </a>

            {variant === "header" && index < links.length - 1 && (
                <span class="separator" aria-hidden="true">
                    /
                </span>
            )}
        </Fragment>
    ))}
</nav>

<style>
    nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: 0 var(--spacing-sm);
    }

    nav[data-variant="header"] a[data-active] {
        color: var(--color-link);
        text-decoration-color: transparent;
    }

    nav[data-variant="footer"] a {
        text-transform: capitalize;
        text-decoration-line: none;
    }

    @media (max-width: 720px) {
        nav[data-variant="header"] {
        }
    }

    .separator {
        color: var(--color-border);
    }
</style>
