---
interface Props {
    variant: "header" | "footer";
    label: string;
}

const { variant, label } = Astro.props;

const HEADER_LINKS = [
    { href: "/", label: "Works" },
    { href: "/about", label: "About" },
    { href: "/blog", label: "Blog" },
];

const FOOTER_LINKS = [
    { href: "/", label: "works" },
    { href: "/blog", label: "blog" },
];

const links = variant === "header" ? HEADER_LINKS : FOOTER_LINKS;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
    if (href === "/") {
        return currentPath === "/";
    }

    return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<nav aria-label={label} data-variant={variant} class="content-boundary">
    {links.map(({ href, label: linkLabel }) => (
        <a
            href={href}
            aria-current={currentPath === href ? "page" : undefined}
            data-active={isActive(href) ? "" : undefined}
        >
            {linkLabel}
        </a>
    ))}
</nav>

<style>
    nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;

        gap: 0 var(--spacing-sm);
    }

    nav[data-variant="header"] {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
    }

    nav[data-variant="header"] :nth-child(2) {
        text-align: center;
    }

    nav[data-variant="header"] :nth-child(3) {
        text-align: right;
    }

    nav[data-variant="header"] a {
        width: 100%;
        padding: calc(var(--spacing-xs) + 0.08em) var(--spacing-lg)
            var(--spacing-xs);
        text-transform: uppercase;
        font-size: var(--font-size-sm);
    }

    nav[data-variant="footer"] a {
        text-transform: capitalize;
        text-decoration-line: none;
    }
</style>
